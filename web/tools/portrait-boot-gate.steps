# M7 TASK 1: A PORTRAIT LOAD BOOTS. The same phone as web/tools/touch-gate.steps,
# held the other way up, driven by REAL TOUCH under phone emulation.
#
#   python3 -m http.server 8008 --directory web/dist-m1 &
#   node web/tools/drive-browser.mjs --headed --mobile 412,915,3 \
#        --out docs/evidence/m7-gameboy/task1-no-hold/portrait-boot \
#        --url http://localhost:8008/armagetronad.html \
#        --script-file web/tools/portrait-boot-gate.steps
#   kill %1
#
# 412x915 at dpr 3 is the portrait CSS viewport of the Pixel-class device the
# touch gate drives in landscape (915x412). The device is the same and the route
# through the menus is the same; the only difference is which way up the page
# was loaded, which is the whole claim under test.
#
# WHAT IS REAL AND WHAT IS NOT is what touch-gate.steps says: the taps are real
# (Input.dispatchTouchEvent, isTrusted TRUE), the KeyboardEvent the overlay
# builds in response is the synthetic half, and emulation supplies a viewport, a
# device pixel ratio and touch events and nothing about a phone's GPU.
#
# THE ROUTE IS THE FIRST-RUN FLOW, as it is there: a fresh profile lands on the
# language menu, then First Setup, then a welcome message, then the tutorial
# match, and each is dismissed by TAPPING. Reaching [L] NEW_ROUND in portrait is
# the second half of the claim -- the boot is not held AND the game is playable
# from it.
#
# --headed is REQUIRED, for the reason in drive-browser.mjs's header.

wait:1000

# The frame sampler, copied verbatim from web/tools/fps-resolution-probe.steps
# so the numbers are the same quantity M2 and M5 measured. It counts the game's
# own glFlush/glFinish calls, i.e. buffer swaps.
eval:(()=>{if(window.__fps)return 'already installed';const S={t:new Float64Array(400000),n:0,marks:[],gl:[],polls:0};window.__fps=S;const wrap=(C)=>{if(!C)return;for(const m of ['flush','finish']){const o=C.prototype[m];if(!o)continue;C.prototype[m]=function(){if(S.n<S.t.length)S.t[S.n++]=performance.now();if(S.n%30===0){S.polls++;const e=this.getError();if(e){S.gl.push([S.n,e]);if(S.gl.length<=20)console.error('[GLERR] frame '+S.n+' glGetError=0x'+e.toString(16));}}return o.apply(this,arguments);};}};wrap(window.WebGLRenderingContext);wrap(window.WebGL2RenderingContext);const cl=console.log.bind(console);console.log=function(){const s=(arguments.length&&typeof arguments[0]==='string')?arguments[0]:'';if(s.indexOf('[L] ')===0)S.marks.push([performance.now(),s]);return cl.apply(null,arguments);};return 'frame sampler armed: glFlush+glFinish counted, glGetError polled every 30th frame, [L] lines timestamped'})()

# The tooltip-counter probe, as in web/tools/synthetic-key-gate.steps.
eval:(()=>{const S={};S.rd=(p)=>{try{return Module.FS.readFile(p,{encoding:'utf8'})}catch(e){return null}};S.line=(t,k)=>{if(t===null)return null;const m=t.split('\n').find(l=>{const s=l.trim();return s.indexOf(k)===0&&/\s/.test(s.charAt(k.length))});return m?m.trim().slice(k.length).trim().replace(/\s+/g,' '):null};S.save=()=>{try{Module._aa_web_save_config();return 'saved'}catch(e){return 'SAVE FAILED: '+e}};S.box=(id)=>{const e=document.getElementById(id);if(!e)return 'missing';const r=e.getBoundingClientRect();return Math.round(r.width)+'x'+Math.round(r.height)+'@'+Math.round(r.left)+','+Math.round(r.top)};S.dump=(phase)=>{const sv=S.save();const c=S.rd('/persist/var/user.cfg');const cv=document.getElementById('canvas');const ctx=window.AA_INPUT_CONTEXT?window.AA_INPUT_CONTEXT():null;console.log('[TOUCHGATE] '+JSON.stringify({phase:phase,save:sv,ctx:ctx,ctx_menu:ctx===null?null:!!(ctx&1),ctx_cycle:ctx===null?null:!!(ctx&2),driving_class:document.getElementById('touch').classList.contains('aa-driving'),box_tapzone:S.box('tapzone'),box_tzleft:S.box('tz-left'),box_tzright:S.box('tz-right'),box_escbtn:S.box('escbtn'),box_touchpad:S.box('touchpad'),canvas_w:cv.width,canvas_h:cv.height,mpx:Math.round(cv.width*cv.height/1e4)/100,css_w:Math.round(cv.getBoundingClientRect().width),css_h:Math.round(cv.getBoundingClientRect().height),inner:window.innerWidth+'x'+window.innerHeight,dpr:window.devicePixelRatio,touch_hidden:document.getElementById('touch').hidden,chip_hidden:document.getElementById('reloadchip').hidden,maxTouchPoints:navigator.maxTouchPoints,coarse:window.matchMedia('(hover: none) and (pointer: coarse)').matches,tip_left:S.line(c,'CYCLE_TURN_LEFT_TOOLTIP'),tip_right:S.line(c,'CYCLE_TURN_RIGHT_TOOLTIP')}));return phase};window.__tg=S;return 'probe installed'})()

# PORTRAIT BOOT, NO HOLD. Before M7 a portrait load held main() until the phone
# turned. Now it boots. (Task 2 makes the picture square; here it is still the
# tall squeeze, which is fine -- the claim under test is only "no hold".)
until:1:90000:[BOOT] autostart
mark:PORTRAIT-BOOTED
eval:(()=>{const held=performance.now();const r={rotate_element:document.getElementById('rotate')!==null,touch_visible:!document.getElementById('touch').hidden};r.PASS=!r.rotate_element&&r.touch_visible;console.log('[M7GATE] PB1 portrait-boot-no-hold '+JSON.stringify(r));return 'PB1 '+r.PASS})()

# M7 TASK 2: THE PICTURE IS A SQUARE AT THE TOP. Measured on the ELEMENT rather
# than read back out of the variables that set it -- css_w/css_h come from
# getBoundingClientRect(), which is the browser's own answer after the cascade,
# so a CSS rule that disagreed with the backing store would show here. Four
# separate claims, because each can fail without the others: the script took the
# Game Boy branch (gameboy), the backing store is square (backing_w===backing_h,
# which is what rViewport::Perspective reads), the drawn box is square to within
# a rounding pixel, and the box is anchored at the top of the viewport and spans
# its full width -- i.e. the room below it that Task 3 puts the pad in is real.
eval:(()=>{const c=document.getElementById('canvas');const b=c.getBoundingClientRect();const r={backing_w:c.width,backing_h:c.height,css_w:Math.round(b.width),css_h:Math.round(b.height),css_top:Math.round(b.top),inner_w:window.innerWidth,gameboy:document.documentElement.classList.contains('aa-gameboy'),square_var:getComputedStyle(document.documentElement).getPropertyValue('--aa-square').trim()};r.PASS=r.gameboy&&r.backing_w===r.backing_h&&Math.abs(r.css_w-r.css_h)<=1&&r.css_top===0&&r.css_w===r.inner_w;console.log('[M7GATE] PB2 square '+JSON.stringify(r));return 'PB2 '+r.PASS})()
shot:pb-00-portrait-boot
tap:#tapzone
wait:3000
tap:#tapzone
wait:3500
tap:#tapzone
until:1:120000:[L] NEW_ROUND
mark:PORTRAIT-ROUND-STARTED
# The same 2 s the landscape gate waits before its round-1 screenshot: [L]
# NEW_ROUND is printed while "New Match" is still on screen, and a shot taken on
# that line shows the splash rather than the round it is evidence for.
wait:2500
shot:pb-01-portrait-round
