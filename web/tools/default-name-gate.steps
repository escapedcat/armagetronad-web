# Task 2 test: a fresh profile gets a web_NNNN default, not web_user.
until:1:120000:[BOOT] autostart
probe:
eval:__aa.waitFor(()=>__aa.ctx().menu,30000)
key:Enter
wait:3000
key:Escape
until:1:30000:[PERSISTSAVE] menu-leave
wait:2000
probe:
eval:(()=>{const v=__aa.playerName();return __aa.check('TEXTGATE','D1','default-name',{saved:v,page:window.AA_DEFAULT_NAME||null},/^web_\d{4}$/.test(v||'')&&v===window.AA_DEFAULT_NAME)})()
# D2: A PROFILE SAVED BEFORE THE web_NNNN DEFAULT STILL SAYS web_user, and so
# does every other such player: on the next load the page renames exactly
# web_user, once, to a fresh web_NNNN. D3: a name the player chose is left
# alone. Each sets PLAYER_1 in user.cfg, switches off the unload save for that
# load (it would rewrite user.cfg from memory) and reloads.
eval:__aa.setPlayerName('web_user')
wait:3000
eval:location.reload()
until:2:120000:[BOOT] autostart
wait:6000
probe:
eval:(()=>{const v=__aa.playerName({save:true});return __aa.check('TEXTGATE','D2','web-user-renamed-once',{saved:v},/^web_\d{4}$/.test(v||''))})()
eval:__aa.setPlayerName('escapedcat')
wait:3000
eval:location.reload()
until:3:120000:[BOOT] autostart
wait:6000
probe:
eval:(()=>{const v=__aa.playerName({save:true});return __aa.check('TEXTGATE','D3','chosen-name-kept',{saved:v},v==='escapedcat')})()
