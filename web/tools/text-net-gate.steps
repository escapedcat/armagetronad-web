# The phone keyboard against a real server (web/tools/run-text-net-gate.sh).
# A phone joins under its web_NNNN default name; Enter during the round opens
# the game's own chat line (Enter is the chat key, config/default.cfg), the
# keyboard's hidden field opens with it, a line is "typed" into it, and the
# keyboard's Enter sends it. The runner reads the server's ladder log.
until:1:120000:[BOOT] autostart
eval:(()=>{for(const t of ['keydown','keyup','keypress'])window.addEventListener(t,e=>{if(e.key==='Unidentified'){e.stopImmediatePropagation();e.preventDefault();}},true);return 'filter on'})()
wait:6000
key:Enter
wait:2500
key:Escape
until:1:30000:[PERSISTSAVE] menu-leave
wait:3000
eval:location.reload()
until:2:90000:[PERSIST] populate ok
until:2:120000:[BOOT] autostart
eval:(()=>{for(const t of ['keydown','keyup','keypress'])window.addEventListener(t,e=>{if(e.key==='Unidentified'){e.stopImmediatePropagation();e.preventDefault();}},true);return 'filter on'})()
wait:6000
key:Enter
wait:2500
key:Enter
wait:3500
key:Down:3
wait:1500
key:Enter
wait:3000
key:Enter
wait:12000
eval:'connected='+Module._aa_web_connected()
key:Enter
wait:1500
eval:'chat-line-keyboard='+(document.activeElement.id==='aa-ime'?1:0)
eval:(()=>{const i=document.getElementById('aa-ime');i.value=' hello from a phone';i.dispatchEvent(new InputEvent('input',{inputType:'insertText',data:'hello from a phone'}));return 'typed'})()
wait:800
eval:(()=>{document.getElementById('aa-ime').dispatchEvent(new KeyboardEvent('keydown',{key:'Enter',keyCode:13,bubbles:true,cancelable:true}));return 'keyboard enter'})()
wait:3000
eval:'after-send-keyboard='+(document.activeElement.id==='aa-ime'?1:0)
