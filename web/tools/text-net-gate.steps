# The phone keyboard against a real server (web/tools/run-text-net-gate.sh).
# A phone joins under its web_NNNN default name and plays a round. While its
# cycle is alive the pad's Enter is inert and labelled "Enter" (Enter is the
# chat key, and the pad suppresses it while driving); after the crash it says
# "Chat". A real touch tap on it opens the game's own chat line and the
# keyboard's hidden field; a link is pasted into it, and the keyboard's Enter
# sends it. The runner reads the server's ladder log.
until:1:120000:[BOOT] autostart
eval:(()=>{for(const t of ['keydown','keyup','keypress'])window.addEventListener(t,e=>{if(e.key==='Unidentified'){e.stopImmediatePropagation();e.preventDefault();}},true);return 'filter on'})()
# 9 s, as in leave-hidden-gate: an Enter before the language menu is up
# leaves first setup unfinished, and boot 2 then starts in a local round.
wait:9000
key:Enter
wait:2500
key:Escape
until:2:30000:[PERSISTSAVE] menu-leave
# SAVE AGAIN BEFORE THE RELOAD. The game clears FIRST_USE only after First
# Setup has closed (gArmagetron.cpp), so the save as it closes still says
# FIRST_USE 1, and boot 2 would be a first run again whenever the unload-time
# save lost the race with the reload. (Dismissing the welcome message to get a
# third menu save was tried: its own key-up sometimes dismisses it first.)
wait:2000
eval:(()=>{Module._aa_web_save_config();return 'saved after first setup'})()
wait:3000
eval:location.reload()
until:2:90000:[PERSIST] populate ok
until:2:120000:[BOOT] autostart
eval:(()=>{for(const t of ['keydown','keyup','keypress'])window.addEventListener(t,e=>{if(e.key==='Unidentified'){e.stopImmediatePropagation();e.preventDefault();}},true);return 'filter on'})()
wait:6000
key:Enter
wait:2500
key:Enter
wait:3500
key:Down:3
wait:1500
key:Enter
wait:3000
key:Enter
wait:12000
eval:'connected='+Module._aa_web_connected()
eval:(()=>{const t=document.getElementById('touch');let seen=false;new MutationObserver(()=>{if(!seen&&t.classList.contains('aa-driving')){seen=true;console.log('[ALIVE] driving');}else if(seen===true&&!t.classList.contains('aa-driving')){seen='dead';console.log('[ALIVE] crashed');}}).observe(t,{attributes:true,attributeFilter:['class']});return 'armed'})()
until:1:90000:[ALIVE] driving
wait:300
eval:'driving-label='+document.querySelector('#pad .pad-a').textContent
until:1:90000:[ALIVE] crashed
wait:600
eval:'crashed-label='+document.querySelector('#pad .pad-a').textContent
shot:chat-label
tap:#tapzone
wait:800
eval:'picture-tap-chat='+((Module._aa_web_input_context()&1)?1:0)+','+(document.activeElement.id==='aa-ime'?1:0)
tap:.pad-a
wait:800
eval:'after-tap-keyboard='+(document.activeElement.id==='aa-ime'?1:0)
tap:#tapzone
wait:600
eval:'picture-hides-keyboard='+(document.activeElement.id==='aa-ime'?0:1)+','+((Module._aa_web_input_context()&1)?1:0)
tap:#tapzone
wait:600
eval:'picture-shows-keyboard='+(document.activeElement.id==='aa-ime'?1:0)
eval:(()=>{const i=document.getElementById('aa-ime');i.value=' Play it on your phone: https://escapedcat.github.io/armagetronad-web/';i.dispatchEvent(new InputEvent('input',{inputType:'insertFromPaste'}));return 'pasted'})()
wait:400
shot:chat-typing
eval:(()=>{document.getElementById('aa-ime').dispatchEvent(new KeyboardEvent('keydown',{key:'Enter',keyCode:13,bubbles:true,cancelable:true}));return 'sent'})()
wait:2500
eval:'after-send-keyboard='+(document.activeElement.id==='aa-ime'?1:0)
shot:chat-sent
# AN EMPTY LINE IS NOT SENT: once the pad says Chat again (a new round may
# have started; then that is after the next crash), open the chat line and
# press the keyboard's Enter with nothing typed. The runner counts the
# server's CHAT lines (one).
eval:(()=>{const b=document.querySelector('#pad .pad-a');const go=()=>{if(b.textContent==='Chat'){o.disconnect();console.log('[NETGATE] chat-ready-again');}};const o=new MutationObserver(go);o.observe(b,{childList:true,characterData:true,subtree:true});setTimeout(go,1500);return 'waiting for Chat'})()
until:1:90000:[NETGATE] chat-ready-again
wait:300
tap:.pad-a
wait:1200
eval:'empty-test-keyboard='+(document.activeElement.id==='aa-ime'?1:0)
eval:(()=>{document.getElementById('aa-ime').dispatchEvent(new KeyboardEvent('keydown',{key:'Enter',keyCode:13,bubbles:true,cancelable:true}));return 'empty enter'})()
wait:2500
eval:'after-empty-enter-menu='+((Module._aa_web_input_context()&1)?1:0)
