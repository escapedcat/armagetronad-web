# The M5 task-1 gate: the viewport-configuration screen does not kill the tab.
#
#   python3 -m http.server 8000 --directory web/dist-m1 &
#   node web/tools/drive-browser.mjs --headed --out /tmp/gate-vp-chrome \
#        --script-file web/tools/viewport-menu-gate.steps
#   node web/tools/drive-firefox.mjs          --out /tmp/gate-vp-firefox \
#        --script-file web/tools/viewport-menu-gate.steps
#   kill %1
#
# --headed is REQUIRED for Chrome; see the header of drive-browser.mjs. Firefox
# headless is fine. Both drivers were run against this file for the fix.
#
# WHAT IT GUARDS. rViewportConfiguration::DemonstrateViewport (rViewport.cpp)
# used to leave its BeginLineLoop() open across a glColor3f, which is
# docs/porting/browser-runtime-notes.md section 10: Emscripten derives one
# vertex format per glBegin/glEnd block, the colour became a per-vertex
# attribute, and glEnd asserted `numVertices` must be an integer (17 slots
# against a 20-byte stride = 3.4). The tab died. Four milestones recorded the
# site as "latent"; it was four keystrokes from the main menu.
#
# PASS looks like: twenty screenshots, all twenty different, and a transcript
# with no "Aborted(", no "numVertices", no [EXCEPTION]. The only acceptable 404
# is /favicon.ico. Under Chrome the glGetError probe after shot 08 must read
# 0x0 -- section 10's OTHER failure mode is silent, so "it did not abort" is
# not on its own a pass; the shots have to show the panels too.
#
# WHY THE ROUTE STARTS WITH A RELOAD. This screen lives off the real main menu,
# and a fresh browser profile has an empty IndexedDB, so /persist starts empty
# and boot 1 is always the first-use flow (language menu -> First Setup). Boot 1
# walks it, M4's persistence writes a user.cfg with FIRST_USE 0, and boot 2 then
# lands on the main menu directly. This is the same two-boot shape as
# persistence-milestone-gate.steps and for the same reason.
#
# WHY Down x4. sg_PlayerMenu() (gMenus.cpp) builds seven items: the uMenu ctor's
# implicit uMenuItemExit, then vp_selec ("Assign Viewports to Players"), then
# the ArmageTron_viewport_menuitem ("Viewports: ..."), then names[3..0]. uMenu
# clamps its initial `selected` to items.Len()-1, so the menu opens on "Player 1
# Settings" and the viewport item is index 2 -- four Downs down. uMenu::OnEnter
# calls RenderBackground() on the SELECTED item only, so highlighting it is the
# whole trigger: no Enter, no Left/Right needed to crash the old build.
#
# The item counts are what the Down count depends on, not the pixel layout. If
# a future change adds or removes a Player_men item, this script walks past the
# viewport item silently and still "passes" -- so read shot 08 and check the
# highlighted line really says "Viewports:", do not trust the step count alone.
until:1:90000:[PERSIST] populate ok
wait:1000
until:1:120000:[BOOT] autostart
wait:9000
shot:01-boot1-language-menu
key:Enter
wait:3000
shot:02-boot1-first-setup
key:Escape
until:1:30000:[PERSISTSAVE] menu-leave
wait:3000
shot:03-boot1-after-first-setup
mark:RELOAD-SO-BOOT-2-STARTS-AT-THE-REAL-MAIN-MENU
eval:location.reload()
until:2:90000:[PERSIST] populate ok
wait:2000
until:2:120000:[BOOT] autostart
wait:12000
shot:04-boot2-main-menu
mark:DOWN-1-SHOULD-HIGHLIGHT-PLAYER-SETUP
key:Down
wait:1500
shot:05-cursor-on-player-setup
key:Enter
wait:3000
shot:06-player-menu-top-item
mark:FOUR-DOWNS-THE-FOURTH-USED-TO-KILL-THE-TAB
key:Down
wait:1000
key:Down
wait:1000
key:Down
wait:1000
shot:07-cursor-on-player-4
key:Down
wait:4000
shot:08-VIEWPORTS-HIGHLIGHTED-THIS-IS-THE-CRASH-POINT
eval:(()=>{const c=document.getElementById('canvas');const g=c.getContext('webgl');return 'alive, gl err=0x'+(g?g.getError().toString(16):'nogl')})()
# Every configuration draws one more line-loop + DisplayText pair per frame, so
# cycling all six exercises the fixed block 1..4 times per frame rather than once.
mark:CYCLE-ALL-SIX-VIEWPORT-CONFIGURATIONS
key:Right
wait:1800
shot:09-config-2
key:Right
wait:1800
shot:10-config-3
key:Right
wait:1800
shot:11-config-4
key:Right
wait:1800
shot:12-config-5
key:Right
wait:1800
shot:13-config-6
key:Right
wait:1800
shot:14-config-clamped-at-6
mark:BACK-TO-SINGLE-PLAYER
key:Left:5
wait:2500
shot:15-back-to-single-player
# ArmageTronPlayer_to_viewport_menuitem::RenderBackground is the second caller
# of DemonstrateViewport and reaches the same block by a different path.
mark:THE-OTHER-DemonstrateViewport-CALLER
key:Down
wait:1500
shot:16-cursor-on-assign-viewports
key:Enter
wait:3500
shot:17-assign-viewports-to-players
key:Right
wait:1800
shot:18-assign-after-right
key:Escape
wait:2500
shot:19-back-in-player-setup
key:Escape
wait:2500
shot:20-back-in-main-menu
eval:(()=>{const c=document.getElementById('canvas');return 'still alive, canvas '+c.width+'x'+c.height})()
