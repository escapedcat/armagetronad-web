# INPUT LAG GATE (web/shell.html "INPUT LAG PROBE", src/emscripten/eWebInputLag.cpp).
# With ?inputlag=1 the page times each turn from the press to the moment the
# game's local cycle has taken it (its turn count went up), and shows that
# beside the frame rate. An emulated phone in the first-run tutorial round:
# after the countdown (turns are ignored before game time 0), real taps on the
# driving pad's halves must each produce an "[INPUTLAG] turn N ms" line, and
# the overlay must show a frame rate. It also checks the pad no longer
# vibrates: navigator.vibrate is watched and must never be called.
#
#   python3 -m http.server 8008 --directory web/dist-m1 &
#   node web/tools/drive-browser.mjs --out /tmp/lag --mobile 412,915,3 \
#     --url 'http://localhost:8008/armagetronad.html?inputlag=1' \
#     --script-file web/tools/input-lag-gate.steps
#   grep -o '\[LAGGATE\] .*' /tmp/lag/console.log    # every line "PASS":true
until:1:120000:[BOOT] autostart
eval:(()=>{for(const t of ['keydown','keyup','keypress'])window.addEventListener(t,e=>{if(e.key==='Unidentified'){e.stopImmediatePropagation();e.preventDefault();}},true);window.__vib=0;try{navigator.vibrate=()=>{window.__vib++;return true}}catch(e){}return 'ready'})()
wait:9000
key:Enter
wait:2500
key:Escape
wait:2500
key:Space
until:1:60000:-> STEERING
# Game time zero is about 3.5 s into the round; turns before it are ignored.
wait:4000
tap:#dp-left
wait:900
tap:#dp-right
wait:900
eval:(()=>{const o=document.getElementById('aa-inputlag');const t=o?o.textContent:'';const fps=/fps (\d+)/.exec(t);console.log('[LAGGATE] I1 overlay-shows-fps '+JSON.stringify({text:t,PASS:!!fps&&+fps[1]>0}));return 'I1'})()
eval:(()=>{const L=window.AA_INPUTLAG||{samples:[]};const s=L.samples;console.log('[LAGGATE] I2 turns-timed '+JSON.stringify({samples:s,PASS:s.length>=1&&s.every(x=>x>0&&x<1000)}));return 'I2'})()
eval:(()=>{const v=window.__vib|0;console.log('[LAGGATE] I3 no-vibration '+JSON.stringify({calls:v,PASS:v===0}));return 'I3'})()
