# THE PHASE 3 GATE: does a JavaScript-SYNTHESIZED keyboard event reach the game?
#
#   python3 -m http.server 8000 --directory web/dist-m1 &
#   node web/tools/drive-browser.mjs --headed --out /tmp/synkey-chrome \
#        --url 'http://localhost:8000/armagetronad.html?autostart=0' \
#        --script-file web/tools/synthetic-key-gate.steps
#   kill %1
#
# WHY IT EXISTS. Phase 3's whole premise -- a touch overlay in web/shell.html
# with zero C++ changes -- rests on `new KeyboardEvent(...)` +
# `dispatchEvent(...)` being indistinguishable, to this game, from a real key
# press. Such an event carries isTrusted:false, and trust demonstrably matters
# elsewhere in this port: a synthetic click is not a user gesture, which is why
# M4's audio work routed around it and why every gate before this one presses
# keys with CDP's Input.dispatchKeyEvent (a real, trusted event) rather than
# with dispatchEvent. Whether trust matters for KEY DELIVERY had never been
# tested. This is the test.
#
# --headed is REQUIRED, for the same reason every other key-pressing gate needs
# it: headless Chrome 152 floods the page with thousands of spurious keydown
# events per real one (see the header of web/tools/drive-browser.mjs). This
# script still uses REAL keys to walk the menus, so it inherits that.
#
# THE WITNESS IS THE GAME'S OWN TOOLTIP COUNTER, exactly as in
# web/tools/persistence-milestone-gate.steps -- read that file's long header for
# why it is exact and what it does and does not prove. In one line:
# uBindPlayer::DoActivate decrements CYCLE_TURN_{LEFT,RIGHT}_TOOLTIP only when
# the press resolved through keymap[] to that action for player 1 AND the
# player's cycle object accepted and executed the turn. config/default.cfg ships
# the counters as "0 2 1 1 1" and "0 3 1 1 1", so 2 and 3 are the budget.
#
# THE TWO COUNTERS ARE SPENT SEPARATELY, ON PURPOSE. Left is dispatched at
# `document` and right at the CANVAS, so one run answers both questions:
# Emscripten's SDL registers its keydown/keyup/keypress listeners on `document`
# (SDL_Init in the generated armagetronad.js sets keyboardListeningElement =
# document), so a canvas-targeted event can only arrive by BUBBLING, and that is
# a separate claim from "document works".
#
# THE POSITIVE CONTROL IS AT THE END AND IS DELIBERATELY REDUNDANT ON A PASS.
# If the synthetic presses spend both counters there is nothing left for a real
# key to decrement, and none is needed: the counters started at 2 and 3 and only
# an accepted turn moves them. The control exists so that a FAILING run cannot
# be confused with a run whose route never reached a live round -- it presses
# real arrows on the same route and dumps again.
#
# BOOT 1 SETS THE GAME UP; BOOT 2 PLAYS. Same reason as the milestone gate: the
# PLAYER_BIND lines for the turn actions are not in user.cfg after boot 1's
# first-setup save (measured -- docs/evidence/m4-persistence/chrome-console.log
# shows left_binds [] there and ["1104","117"] on boot 2), and this gate reads
# its answer out of that file.

# ===========================================================================
# THE PROBE. Installed before anything runs, on every page load.
# ===========================================================================

until:1:90000:[PERSIST] populate ok
mark:BOOT-1-POPULATED
wait:1000

eval:(()=>{const S={};S.rd=(p)=>{try{return Module.FS.readFile(p,{encoding:'utf8'})}catch(e){return null}};S.line=(t,k)=>{if(t===null)return null;const m=t.split('\n').find(l=>{const s=l.trim();return s.indexOf(k)===0&&/\s/.test(s.charAt(k.length))});return m?m.trim().slice(k.length).trim().replace(/\s+/g,' '):null};S.keys=(t)=>t===null?[]:t.split('\n').filter(l=>l.trim().indexOf('KEYBOARD')===0).map(l=>l.trim().replace(/\s+/g,' '));S.binds=(K,a)=>K.filter(l=>l.indexOf(' PLAYER_BIND '+a+' 1')>0).map(l=>l.split(' ')[1]);S.save=()=>{try{Module._aa_web_save_config();return 'saved'}catch(e){return 'SAVE FAILED: '+e}};S.dump=(phase)=>{const sv=S.save();const c=S.rd('/persist/var/user.cfg');const K=S.keys(c);console.log('[SYNKEY] '+JSON.stringify({phase:phase,save:sv,present:c!==null,bytes:c===null?null:c.length,first_use:S.line(c,'FIRST_USE'),left_binds:S.binds(K,'CYCLE_TURN_LEFT'),right_binds:S.binds(K,'CYCLE_TURN_RIGHT'),tip_left:S.line(c,'CYCLE_TURN_LEFT_TOOLTIP'),tip_right:S.line(c,'CYCLE_TURN_RIGHT_TOOLTIP')}));return phase};window.__syn=S;return 'probe installed'})()

# The synthesizer under test. Nothing here is clever: a KeyboardEvent built by
# hand, with the five properties Emscripten's SDL shim could plausibly read, and
# dispatched at a named element. isTrusted and defaultPrevented are recorded per
# press because they are the two things the page can see about the event's fate
# WITHOUT reaching into the module -- defaultPrevented flips to true only if
# SDL.receiveEvent ran and called preventDefault on it.
eval:(()=>{window.__press=async function(where,n,keyCode,code,key){const t=(where==='document')?document:document.getElementById('canvas');const mk=(type)=>new KeyboardEvent(type,{key:key,code:code,keyCode:keyCode,which:keyCode,bubbles:true,cancelable:true});const nap=(ms)=>new Promise(r=>setTimeout(r,ms));const info=[];for(let i=0;i<n;i++){const d=mk('keydown');t.dispatchEvent(d);info.push('isTrusted='+d.isTrusted+' keyCode='+d.keyCode+' defaultPrevented='+d.defaultPrevented);await nap(40);t.dispatchEvent(mk('keyup'));await nap(320)}console.log('[SYNKEY] dispatched '+n+'x '+key+' at '+where+' :: '+info.join(' | '));return where+':'+n};return 'presser installed, SDL global is '+(typeof SDL)})()

eval:window.__syn.dump('boot1-before-play')

# ===========================================================================
# BOOT 1 -- language menu, First Setup. Real keys throughout: this half is
# setup, not measurement.
# ===========================================================================
eval:window.AA_START()
wait:9000
shot:00-boot1-language-menu
key:Enter
until:1:30000:[PERSISTSAVE] menu-leave
wait:2500
shot:01-boot1-first-setup
key:Escape
until:2:30000:[PERSISTSAVE] menu-leave
wait:3000
eval:window.__syn.dump('boot1-after-first-setup')

mark:RELOAD-REQUESTED
eval:location.reload()

until:2:90000:[PERSIST] populate ok
mark:BOOT-2-POPULATED
wait:1500

eval:(()=>{const S={};S.rd=(p)=>{try{return Module.FS.readFile(p,{encoding:'utf8'})}catch(e){return null}};S.line=(t,k)=>{if(t===null)return null;const m=t.split('\n').find(l=>{const s=l.trim();return s.indexOf(k)===0&&/\s/.test(s.charAt(k.length))});return m?m.trim().slice(k.length).trim().replace(/\s+/g,' '):null};S.keys=(t)=>t===null?[]:t.split('\n').filter(l=>l.trim().indexOf('KEYBOARD')===0).map(l=>l.trim().replace(/\s+/g,' '));S.binds=(K,a)=>K.filter(l=>l.indexOf(' PLAYER_BIND '+a+' 1')>0).map(l=>l.split(' ')[1]);S.save=()=>{try{Module._aa_web_save_config();return 'saved'}catch(e){return 'SAVE FAILED: '+e}};S.dump=(phase)=>{const sv=S.save();const c=S.rd('/persist/var/user.cfg');const K=S.keys(c);console.log('[SYNKEY] '+JSON.stringify({phase:phase,save:sv,present:c!==null,bytes:c===null?null:c.length,first_use:S.line(c,'FIRST_USE'),left_binds:S.binds(K,'CYCLE_TURN_LEFT'),right_binds:S.binds(K,'CYCLE_TURN_RIGHT'),tip_left:S.line(c,'CYCLE_TURN_LEFT_TOOLTIP'),tip_right:S.line(c,'CYCLE_TURN_RIGHT_TOOLTIP')}));return phase};window.__syn=S;return 'probe installed'})()

eval:(()=>{window.__press=async function(where,n,keyCode,code,key){const t=(where==='document')?document:document.getElementById('canvas');const mk=(type)=>new KeyboardEvent(type,{key:key,code:code,keyCode:keyCode,which:keyCode,bubbles:true,cancelable:true});const nap=(ms)=>new Promise(r=>setTimeout(r,ms));const info=[];for(let i=0;i<n;i++){const d=mk('keydown');t.dispatchEvent(d);info.push('isTrusted='+d.isTrusted+' keyCode='+d.keyCode+' defaultPrevented='+d.defaultPrevented);await nap(40);t.dispatchEvent(mk('keyup'));await nap(320)}console.log('[SYNKEY] dispatched '+n+'x '+key+' at '+where+' :: '+info.join(' | '));return where+':'+n};return 'presser installed, SDL global is '+(typeof SDL)})()

# ===========================================================================
# BOOT 2 -- the measurement.
# ===========================================================================
eval:window.__syn.dump('boot2-before-play')
eval:window.AA_START()
wait:10000
shot:02-boot2-main-menu

# ---------------------------------------------------------------------------
# FIRST, THE MENUS, WITH SYNTHETIC KEYS ONLY. This is the second half of Step
# 2's requirement -- a visitor who cannot get past the language menu has not
# been given mobile support -- and it is measurable here for free: if the route
# from the main menu into a running round can be walked entirely by dispatched
# events, the menu half of the overlay is proven before it is written.
#
# Main menu: Play Game (selected) / Player Setup / System Setup / About / Exit.
# Enter opens the Play Game submenu; Down moves to Start New Game; Enter starts.
mark:SYNTHETIC-MENU-NAVIGATION
eval:window.__press('document',1,13,'Enter','Enter')
wait:2500
shot:03-boot2-play-game-submenu-via-synthetic-enter
eval:window.__press('document',1,40,'ArrowDown','ArrowDown')
wait:1500
shot:04-boot2-cursor-on-start-new-game-via-synthetic-down
eval:window.__press('document',1,13,'Enter','Enter')
wait:3000

until:1:90000:[L] NEW_ROUND
mark:ROUND-1-STARTED
wait:1500
shot:05-boot2-round1-driving

# ---------------------------------------------------------------------------
# THE GATE ITSELF.
mark:SYNTHETIC-LEFT-AT-DOCUMENT
eval:window.__press('document',3,37,'ArrowLeft','ArrowLeft')
wait:800
shot:06-after-synthetic-left-at-document
eval:window.__syn.dump('after-synthetic-left-at-document')

mark:SYNTHETIC-RIGHT-AT-CANVAS
eval:window.__press('canvas',4,39,'ArrowRight','ArrowRight')
wait:800
shot:07-after-synthetic-right-at-canvas
eval:window.__syn.dump('after-synthetic-right-at-canvas')

# A second round, in case round 1's cycle was already dead when the presses
# landed. gCycle::Act's premature-input guard returns false during the
# countdown, and a dead player has no cycle object to accept the turn, so a run
# that spends its whole budget in a bad window would report a false negative.
until:2:120000:[L] NEW_ROUND
mark:ROUND-2-STARTED
wait:1500
eval:window.__press('document',3,37,'ArrowLeft','ArrowLeft')
eval:window.__press('canvas',4,39,'ArrowRight','ArrowRight')
wait:800
shot:08-after-round2-synthetic
eval:window.__syn.dump('after-round2-synthetic')

# ---------------------------------------------------------------------------
# THE POSITIVE CONTROL: real, trusted, CDP-dispatched arrows on the same route.
# Redundant if the counters are already 0; decisive if they are not.
until:3:120000:[L] NEW_ROUND
mark:ROUND-3-REAL-KEYS-POSITIVE-CONTROL
wait:1500
key:Left:2
key:Right:3
wait:1000
shot:09-after-real-keys
eval:window.__syn.dump('after-real-keys')

# ---------------------------------------------------------------------------
# CONTROL: can this transcript see a browser-reported JS error at all? Last,
# because web/shell.html turns an uncaught error into a red failure banner.
mark:positive-control-deliberate-uncaught-error-follows
eval:setTimeout(function(){null.thisIsADeliberateUncaughtError;},0)
wait:2000
shot:10-after-deliberate-uncaught-error
