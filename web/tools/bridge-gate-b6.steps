# M-A gate B6: ONE ROUND ON A SERVER THIS PROJECT DOES NOT OWN.
#
# Run it with web/tools/run-bridge-b6.sh, which starts the helpers, names the
# address the run is supposed to reach and checks afterwards that it reached
# THAT one:
#
#   sh web/tools/run-bridge-b6.sh docs/evidence/m-a-bridge/b6/local  127.0.0.1        4534 local
#   sh web/tools/run-bridge-b6.sh docs/evidence/m-a-bridge/b6/remote 188.245.106.232  4537 remote
#
# ---------------------------------------------------------------------------
# WHY THIS IS A SECOND FILE AND NOT AN EIGHTH SECTION OF bridge-gate.steps.
# Two reasons, both structural rather than stylistic:
#
#   1. bridge-gate.steps ends with B5, which KILLS THE RELAY, and says in its
#      own words "THIS MUST BE LAST IN THE FILE. After it there is no relay, so
#      nothing after it could mean anything." A B6 appended after B5 would run
#      with no transport at all and could only time out -- and `until:` does not
#      throw, so the PASS line after it would still have printed. That is the
#      exact vacuous-pass shape this milestone has already been bitten by twice.
#   2. B6 connects somewhere else. bridge-gate.steps reaches 127.0.0.1 through
#      the committed CUSTOM_SERVER_NAME; B6 needs a different address, which is
#      an UNCOMMITTED edit to web/webdefaults/autoexec.cfg (the repo must never
#      ship a third party's address -- see the note beside CUSTOM_SERVER_NAME).
#      Keeping the two gates in one file would mean one file that only works
#      when the tree is dirty.
#
# EVERYTHING ELSE IS bridge-gate.steps'. The boot/reload dance, the taps, the
# milestone ticker, the error-counter baseline and the menu walk are all copied
# from it, and the long banner comment there headed "THE MENU PATH TO A
# BOOKMARKED SERVER" is still the explanation for the key counts below --
# named, not quoted, so there is one copy of that reasoning and not two.
#
# ---------------------------------------------------------------------------
# THE ONE NEW INSTRUMENT: A ROUND TRIP, NOT A GAP.
#
# Task 4's sampler measured inter-arrival GAPS between datagrams delivered to
# the page. A gap answers "how often does the far end speak", which on
# loopback and across the Atlantic can be the same number while the latency is
# not. B6 exists to price a real network, so it needs a round trip.
#
# The game already measures one. nWaitForAck::Ackt (src/network/nNetwork.cpp:846)
# does `REAL thisping = netTime - ack->timeFirstSent;` when an acknowledgement
# for a message id comes back, and that is the number the score table prints in
# its ping column (src/engine/ePlayer.cpp:6530, `int(p->ping*1000)`). The tap
# below recovers the same pairing from the wire, from inside the page, so it
# measures THE WHOLE PATH: page -> WebSocket -> relay -> UDP -> server and all
# the way back. web/tools/bridge-rtt-relay.mjs does the same pairing at the
# relay's UDP socket, where the browser leg is excluded; the difference between
# the two is what the bridge itself costs. web/tools/bridge-rtt.py explains the
# packet layout and both directions.
#
# WHAT THE RTT NUMBER IS NOT. An ack is not sent the instant a message lands:
# the game batches acks and flushes them on its next send, so every sample
# carries one send-cadence of the game's own delay on top of the wire time.
# That is a property of Armagetron and is present in both arms, which is why
# this gate is ALWAYS run twice -- once against the local container and once
# against the real server -- and why the number that gets reported is the
# DIFFERENCE. A single absolute figure from this instrument would be wrong.
#
# WHY THE TAP IS INSTALLED BEFORE THE MENU WALK AND RESET BEFORE THE CONNECT.
# It has to exist before AABridge.ws does, because library_bridge.js assigns
# `AABridge.ws.onmessage = AABridge.onmessage` once at construction
# (web/library_bridge.js:153) -- wrapping the property afterwards would be too
# late for the handshake. But the LAN walk in between sends datagrams of its
# own (to port 0, which the relay refuses), and their message ids would sit in
# the pending map and could collide with the real game's. So it is installed
# early and its state is cleared immediately before the connect.
# ===========================================================================

until:1:90000:[PERSIST] populate ok
wait:1000
until:1:120000:[BOOT] autostart
wait:9000
shot:01-boot1-language-menu
key:Enter
wait:3000
shot:02-boot1-first-setup
key:Escape
until:1:30000:[PERSISTSAVE] menu-leave
wait:3000
mark:RELOAD-SO-BOOT-2-STARTS-AT-THE-REAL-MAIN-MENU
eval:location.reload()
until:2:90000:[PERSIST] populate ok
until:2:120000:[BOOT] autostart
wait:12000
shot:03-boot2-main-menu

# The peer tap. eWebNet::Recv logs one of these per distinct address text it
# maps, and it is the page's own record of WHO it is talking to -- read back in
# the verdict, where the assertion is that exactly one peer was seen and that a
# dotted quad mapped to itself rather than into the synthetic 10.42.0.0/16.
eval:(()=>{const o=console.log;if(console.log.__aa)return 'already';window.__peers=[];const w=function(){try{const s=String(arguments[0]);if(s.indexOf('[BRIDGE] peer ')===0)window.__peers.push(s)}catch(e){}return o.apply(console,arguments)};w.__aa=true;console.log=w;return 'peer-line tap installed'})()

# The ladder-log tap and the milestone ticker, both verbatim from
# bridge-gate.steps -- see the long comments there for why a bare `until:` on
# an `[L]` line counts boot 1's local game and is therefore satisfied on
# arrival.
eval:(()=>{if(window.__lTap)return 'already';window.__lTap=true;window.__L={};const o=console.log;const w=function(){try{const s=String(arguments[0]);if(s.indexOf('[L] ')===0){const k=s.slice(4).split(' ')[0];window.__L[k]=(window.__L[k]||0)+1}}catch(e){}return o.apply(console,arguments)};console.log=w;return 'ladder-log tap installed'})()
eval:(()=>{if(window.__gw)return 'already';window.__gw={};window.__gwTimer=setInterval(()=>{const L=window.__L||{};const say=(k)=>{if(!window.__gw[k]){window.__gw[k]=1;console.log('[GATEWAIT] '+k)}};const n=L.NEW_ROUND|0,sc=L.ROUND_SCORE_TEAM|0,ro=L.TEAM_PLAYER_ADDED|0;for(let i=1;i<=8;i++){if(ro>=i)say('ROSTER-'+i);if(n>=i)say('STARTED-'+i);if(sc>=i)say('SCORED-'+i)}},500);return 'gate-wait milestone ticker installed'})()

# The ack-pairing round-trip tap. See the banner above for what it measures and
# what it does not.
eval:(()=>{if(window.__rttTap)return 'already';window.__rttTap=1;const R={sent:{},samples:[],addrs:{},outD:0,inD:0,parseFail:0};R.reset=function(){R.sent={};R.samples=[];R.addrs={};R.outD=0;R.inD=0;R.parseFail=0;return 'rtt state cleared'};window.__rtt=R;const head=(u)=>{if(u.length<7||u[0]!==1)return null;const al=u[6];if(u.length<7+al)return null;let a='';for(let i=0;i<al;i++)a+=String.fromCharCode(u[7+i]);return {type:u[1],addr:a,off:7+al}};const parse=(u,off)=>{const e=u.length-2;const out=[];let p=off;while(p+6<=e){const d=(u[p]<<8)|u[p+1];const id=(u[p+2]<<8)|u[p+3];const dl=(u[p+4]<<8)|u[p+5];p+=6;if(p+dl*2>e)return out;if(d===1){const a=[];for(let i=0;i<dl;i++)a.push((u[p+i*2]<<8)|u[p+i*2+1]);out.push({d:1,acks:a})}else out.push({d:d,id:id});p+=dl*2}return out};const onOut=(u)=>{const h=head(u);if(!h||h.type!==3)return;R.outD++;R.addrs[h.addr]=(R.addrs[h.addr]|0)+1;const ms=parse(u,h.off);if(!ms.length){R.parseFail++;return}const t=performance.now();for(const m of ms)if(m.d!==1&&m.id&&R.sent[m.id]===undefined)R.sent[m.id]=t};const onIn=(u)=>{const h=head(u);if(!h||h.type!==3)return;R.inD++;const ms=parse(u,h.off);if(!ms.length){R.parseFail++;return}const t=performance.now();for(const m of ms)if(m.d===1)for(const a of m.acks)if(R.sent[a]!==undefined){R.samples.push(Math.round((t-R.sent[a])*100)/100);delete R.sent[a]}};const proto=WebSocket.prototype;const realSend=proto.send;proto.send=function(d){try{onOut(d instanceof Uint8Array?d:new Uint8Array(d))}catch(e){}return realSend.apply(this,arguments)};const realOn=window.AABridge.onmessage;window.AABridge.onmessage=function(ev){try{onIn(new Uint8Array(ev.data))}catch(e){}return realOn.apply(this,arguments)};return 'ack-pairing rtt tap installed'})()

# ===========================================================================
# B6-0: CONFIGURED, AND IDLE UNTIL THE GAME ASKS. bridge-gate.steps' B0,
# repeated here because this file is run on its own and the claim "nothing was
# attempted before the menu asked" has to hold for THIS run, not for another.
# ===========================================================================
eval:(()=>{const b=window.AABridge;const r={present:!!b,ws_constructed:!!(b&&b.ws),url_parsed:b?b.urlChecked:null,url:b?b.url:null,queues:b?Object.keys(b.queues).length:null};r.PASS=!!b&&!r.ws_constructed&&r.url_parsed===false;console.log('[BRIDGEGATE] B6-0 configured-and-idle-until-asked '+JSON.stringify(r));return 'B6-0 '+r.PASS})()

