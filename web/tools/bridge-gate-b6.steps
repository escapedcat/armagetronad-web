# The gap sampler, installed on the live socket now that there is one, so its
# percentiles are comparable with Task 4's table in
# docs/evidence/m-a-bridge/README.md -- same instrument, same phase boundary.
eval:(()=>{try{const b=window.AABridge;if(!b||!b.ws)return 'NO LIVE SOCKET - the sampler measured nothing';if(window.__gapTap)return 'already';window.__gapTap=true;window.__gaps=[];window.__gapLast=0;const inner=b.ws.onmessage;b.ws.onmessage=function(ev){const t=performance.now();if(window.__gapLast)window.__gaps.push(Math.round((t-window.__gapLast)*100)/100);window.__gapLast=t;return inner.apply(this,arguments)};return 'gap sampler installed on the live socket'}catch(e){return 'GAP SAMPLER FAILED: '+e}})()

# PLAY. The zigzag is bridge-gate.steps' B3 keypress pair -- the real input
# path, driven while a network round is live. The four lefts after it are new
# and they are a courtesy, not a measurement: on an EMPTY server there may be
# nothing else on the grid to end the round, and this gate must not sit on a
# stranger's slot waiting for a timeout. Four turns in the same direction close
# a box and the cycle dies on its own wall, so the round ends because the
# browser player finished it.
mark:B6-STEER-WHILE-A-NETWORK-ROUND-IS-LIVE
key:Left
wait:600
key:Right
wait:1200
shot:12-after-the-zigzag
mark:B6-CLOSE-THE-BOX-SO-THE-ROUND-ENDS-WITHOUT-LOITERING
key:Left
wait:700
key:Left
wait:700
key:Left
wait:700
key:Left
wait:2500
