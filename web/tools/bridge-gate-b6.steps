# The error-counter baseline, and the reason it is a baseline and not a zero,
# is bridge-gate.steps'. One thing IS different here and it is worth naming:
# the local arm runs the relay WITH --allow-private and the remote arm runs it
# WITHOUT, so the two arms can legitimately reach this line with different
# counts. Only the DELTA across the connect is asserted, which is why that
# difference does not matter.
eval:(()=>{const b=window.AABridge;window.__base={dropped:b.dropped|0,sendFailures:b.sendFailures|0,dataErrors:b.dataErrors|0};return 'error-counter baseline '+JSON.stringify(window.__base)})()

# Clear the LAN walk's message ids out of the round-trip tap. See the banner.
eval:window.__rtt.reset()

mark:B6-DOWN-3-FROM-LAN-TO-SERVER-BOOKMARKS
key:Down:3
wait:1500
shot:09-network-menu-server-bookmarks-selected
mark:B6-ENTER-OPENS-BOOKMARKS-AND-TRANSFERS-CUSTOM_SERVER_NAME
