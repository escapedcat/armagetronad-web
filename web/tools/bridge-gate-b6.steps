shot:20-left
eval:(()=>{const b=window.AABridge;const c=document.getElementById('canvas');const g=c?c.getContext('webgl'):null;const r={ws_readyState:b.ws?b.ws.readyState:null,state:b.state,live_handles:Object.keys(b.queues).map(Number),canvas_w:c?c.width:0,canvas_h:c?c.height:0,gl_err:g?g.getError():'nogl'};r.PASS=r.ws_readyState===3&&r.canvas_w>0&&r.gl_err===0;console.log('[BRIDGEGATE] B6-LEFT the-page-is-off-the-server-and-still-running '+JSON.stringify(r));return 'LEFT '+r.PASS})()
