until:1:90000:[GATEWAIT] STARTED-2
wait:1500
shot:15-a-second-round-started-so-the-first-one-really-ended

# ===========================================================================
# B6: A FULL ROUND COMPLETED ON THIS SERVER, THROUGH THE BRIDGE.
#
# The bridge readings are B3's, unchanged, and the reasoning for each of them
# is in bridge-gate.steps: one live handle, bound 1, sentSinceBind > 0, the
# three error counters unmoved as DELTAS from the baseline, a queue that is
# shallow on two readings 300 ms apart rather than momentarily zero, and
# still_alive from the canvas and GL rather than from the page merely existing.
#
# FOUR THINGS ARE ADDED, AND EVERY ONE OF THEM IS THERE BECAUSE THE OBVIOUS
# VERSION OF THIS GATE COULD PASS WITHOUT LEAVING THE MACHINE:
#
#   peers -- the distinct address texts eWebNet::Recv mapped. Exactly one, and
#     it must be a dotted quad mapping to ITSELF (the "(literal)" branch), not
#     into 10.42.0.0/16. A run that somehow reached a different host would show
#     two, and a run that reached nothing would show none. Which address it is
#     is checked by run-bridge-b6.sh against the address it was told to expect,
#     because a needle hardcoded in here would have to be edited per arm and an
#     edited assertion is not an assertion.
#
#   rtt_samples -- the count of ACK PAIRS. An ack names a message id this page
#     sent; nothing local can produce one. A non-zero count is a statement that
#     a real peer read our messages and answered them, and it is the reading
#     that makes a silent or half-open socket impossible to mistake for a
#     working one.
#
#   rounds_scored and rounds_started, from the tap installed AFTER the reload,
#     so boot 1's local tutorial game cannot contribute to either.
#
#   sent_datagrams -- printed, not just asserted > 0, because "73 at connect,
#     206 at round end" is what says the socket carried a live two-way stream
#     rather than a login followed by silence.
# ===========================================================================
eval:(async()=>{const b=window.AABridge;const L=window.__L||{};const B=window.__base||{dropped:0,sendFailures:0,dataErrors:0};const R=window.__rtt||{samples:[],addrs:{}};const c=document.getElementById('canvas');const g=c?c.getContext('webgl'):null;const live=Object.keys(b.queues).map(Number);const bound=live.map(h=>[h,b.bound[h]===undefined?0:b.bound[h]]);const sent=live.map(h=>[h,b.sentSinceBind[h]|0]);const dep=()=>live.reduce((a,h)=>a+((b.queues[h]||[]).length),0);const p1=dep();await new Promise(rr=>setTimeout(rr,300));const p2=dep();const P=window.__peers||[];const lit=P.filter(l=>/\(literal\)/.test(l)).length;const syn=P.filter(l=>/\(synthetic\)/.test(l)).length;const r={rounds_started:L.NEW_ROUND|0,rounds_scored:L.ROUND_SCORE_TEAM|0,rosters:L.TEAM_PLAYER_ADDED|0,peers:P,peer_literal:lit,peer_synthetic:syn,dialled:R.addrs,rtt_samples:R.samples.length,ws_readyState:b.ws?b.ws.readyState:null,state:b.state,live_handles:live,bound:bound,sent_datagrams:sent,pending_before:p1,pending_after:p2,baseline:B,new_dropped:(b.dropped|0)-B.dropped,new_sendFailures:(b.sendFailures|0)-B.sendFailures,new_dataErrors:(b.dataErrors|0)-B.dataErrors,lastDataError:b.lastDataError,canvas_w:c?c.width:0,canvas_h:c?c.height:0,gl_err:g?g.getError():'nogl'};r.still_alive=r.canvas_w>0&&r.canvas_h>0&&r.gl_err===0;r.draining=p1<=3&&p2<=3;r.one_peer=P.length===1&&lit===1&&syn===0&&Object.keys(R.addrs).length===1;r.PASS=r.rounds_started>=2&&r.rounds_scored>=1&&r.rosters>0&&r.one_peer&&r.rtt_samples>0&&b.state===1&&r.ws_readyState===1&&live.length===1&&bound.every(e=>e[1]===1)&&sent.every(e=>e[1]>0)&&r.draining&&r.new_dropped===0&&r.new_sendFailures===0&&r.new_dataErrors===0&&r.still_alive;console.log('[BRIDGEGATE] B6 a-full-round-on-a-server-this-project-does-not-own '+JSON.stringify(r));return 'B6 '+r.PASS})()

# The two readouts the report is built from. RTT first, because it is the point
# of this run; the gap distribution second, because it is the row that lines up
# with Task 4's table.
eval:(()=>{const R=window.__rtt||{samples:[],addrs:{}};const g=R.samples.slice().sort((a,b)=>a-b);const q=p=>g.length?g[Math.min(g.length-1,Math.floor(p*g.length))]:null;const r={phase:'connect-through-round-2',what:'full-path ack round trip, page to server and back',peers:R.addrs,datagrams_out:R.outD,datagrams_in:R.inD,parse_failures:R.parseFail,unpaired:Object.keys(R.sent).length,n:g.length,min:g.length?g[0]:null,p50:q(.5),p90:q(.9),p99:q(.99),max:g.length?g[g.length-1]:null,mean:g.length?Math.round(g.reduce((a,b)=>a+b,0)/g.length*100)/100:null,over100ms:g.filter(x=>x>100).length,over250ms:g.filter(x=>x>250).length};console.log('[BRIDGEGATE] RTT '+JSON.stringify(r));return 'rtt n='+g.length+' p50='+q(.5)})()
eval:(()=>{const g=(window.__gaps||[]).slice().sort((a,b)=>a-b);const q=p=>g.length?g[Math.min(g.length-1,Math.floor(p*g.length))]:null;const r={phase:'through-B6',datagrams:g.length,p50:q(.5),p90:q(.9),p99:q(.99),max:g.length?g[g.length-1]:null,over100ms:g.filter(x=>x>100).length,over250ms:g.filter(x=>x>250).length,over500ms:g.filter(x=>x>500).length};console.log('[BRIDGEGATE] GAPS '+JSON.stringify(r));return 'gaps '+JSON.stringify(r)})()

# ===========================================================================
# LEAVE. ONE CONNECT, ONE ROUND, THEN GO -- and this half of the gate is a rule
# of conduct rather than a measurement, so it is unconditional and it does not
# wait for anything.
#
# Escape opens the in-game menu, which for a client is MainMenu(ingame=true)
# with sn_GetNetState()==nCLIENT (src/tron/gGame.cpp:2510). Its items are
# constructed exit-first (gGame.cpp:2588) and "Disconnect" second
# (gGame.cpp:2599), so Disconnect is index 1 and the exit item is index 0.
# uMenu renders the highest index at the TOP and opens on it, so those two are
# the bottom two rows of the screen, in that order.
#
# WHICH IS WHY THE WALK IS *UP* AND NOT DOWN, AND WHY TWO IS A SAFE COUNT.
# Up increments the index and wraps, so the first Up goes from the top row
# straight to index 0 ("Return to Game") and the second lands on index 1
# ("Disconnect"). That makes the count relative to the BOTTOM of the menu,
# where the two items are fixed. A Down-count would be relative to the top and
# would be wrong the moment a server changes how many of the optional items
# above them exist -- authenticate is gated on the server's protocol version,
# and police and voting on the net state and settings. Confirmed on the local
# arm: shot 18 has Disconnect selected, with the help line "Disconnects from
# the server and returns to the main menu." Read shot 18 of THIS run too; do
# not trust the count on its own.
#
# AND THEN THE SOCKET IS CLOSED FROM JS REGARDLESS. Not because the menu walk
# is expected to fail, but because "we definitely stopped sending to a stranger"
# must not depend on a key count being right. A client that vanishes is the
# ordinary case on the internet and the server times it out in seconds.
# ===========================================================================
mark:B6-LEAVE-THE-SERVER
key:Escape
wait:2500
shot:16-ingame-menu
key:Up
wait:1200
shot:17-ingame-menu-one-up
key:Up
wait:1200
shot:18-ingame-menu-two-up
key:Enter
wait:4000
shot:19-after-the-disconnect
eval:(()=>{try{if(window.AABridge&&window.AABridge.ws)window.AABridge.ws.close();return 'socket closed from the page as a backstop'}catch(e){return 'backstop close threw: '+e}})()
