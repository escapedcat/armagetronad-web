# PHASE 3: what a phone visitor gets when the page LOADS IN PORTRAIT, and what
# happens when they then rotate.
#
#   python3 -m http.server 8000 --directory web/dist-m1 &
#   node web/tools/drive-browser.mjs --headed --mobile 412,915,3 \
#        --out /tmp/touch-portrait \
#        --url http://localhost:8000/armagetronad.html \
#        --script-file web/tools/touch-portrait-probe.steps
#   kill %1
#
# WHY THIS IS A SEPARATE RUN FROM web/tools/touch-gate.steps. The backing store
# is sized ONCE, before boot, from innerWidth/innerHeight -- so "loaded in
# portrait" and "rotated into portrait" are different states of the program and
# only a second page load can reach the first one. touch-gate.steps measures the
# second; this measures the first.
#
# WHAT IT IS EXPECTED TO SHOW, stated in advance so a surprise is visible:
#   1. The rotate prompt is up BEFORE the game has booted -- it is shown over
#      the loading overlay on purpose, because the useful moment to say "turn
#      the phone" is while the 5 MB of wasm is still downloading.
#   2. The canvas is sized 1236x2745, i.e. the game really has initialised at a
#      1:2.22 portrait aspect. Whether it renders anything sane there is not a
#      claim this port makes; the prompt exists so nobody has to find out.
#   3. Rotating to landscape hides the prompt and raises the reload chip,
#      because the backing store is STILL 1236x2745 and is now being letterboxed
#      into a landscape viewport.
#   4. Tapping Reload re-loads the page, which re-runs the sizing block at the
#      new orientation and gives a 2745x1236 backing store with no chip. That
#      last step is the whole of Phase 3's orientation handling: a prompt and a
#      reload, not a resize.

wait:2500
shot:00-portrait-at-load-while-downloading

until:1:90000:[BOOT] autostart
wait:9000
shot:01-portrait-at-load-after-boot
eval:(()=>{const c=document.getElementById('canvas');const b=c.getBoundingClientRect();return JSON.stringify({canvas:c.width+'x'+c.height,css:Math.round(b.width)+'x'+Math.round(b.height),inner:innerWidth+'x'+innerHeight,rotate_hidden:document.getElementById('rotate').hidden,chip_hidden:document.getElementById('reloadchip').hidden})})()

mark:ROTATE-TO-LANDSCAPE
metrics:915:412:3
wait:2500
shot:02-rotated-to-landscape-after-loading-in-portrait
eval:(()=>{const c=document.getElementById('canvas');const b=c.getBoundingClientRect();return JSON.stringify({canvas:c.width+'x'+c.height,css:Math.round(b.width)+'x'+Math.round(b.height),inner:innerWidth+'x'+innerHeight,rotate_hidden:document.getElementById('rotate').hidden,chip_hidden:document.getElementById('reloadchip').hidden})})()

mark:TAP-THE-RELOAD-CHIP
tap:#reloadchip-go
until:2:90000:[BOOT] autostart
wait:10000
shot:03-after-tapping-reload
eval:(()=>{const c=document.getElementById('canvas');const b=c.getBoundingClientRect();return JSON.stringify({canvas:c.width+'x'+c.height,css:Math.round(b.width)+'x'+Math.round(b.height),inner:innerWidth+'x'+innerHeight,rotate_hidden:document.getElementById('rotate').hidden,chip_hidden:document.getElementById('reloadchip').hidden})})()
