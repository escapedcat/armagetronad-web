# M-A: HOSTING IS REFUSED, and the browser tab never announces itself anywhere.
#
#   python3 -m http.server 8008 --directory web/dist-m1 &
#   node bridge/relay.mjs --port 8010 --allow-private > /tmp/hosting-relay.log 2>&1 &
#   node web/tools/drive-browser.mjs --headed --out /tmp/bridge-hosting \
#        --url 'http://localhost:8008/armagetronad.html?bridge=ws://127.0.0.1:8010' \
#        --script-file web/tools/bridge-hosting-gate.steps
#   kill %1 %2
#
# NO DOCKER CONTAINER AND NO SERVER OF ANY KIND. The walk below is LAN browse,
# whose broadcast the shim refuses outright (nSocket::Broadcast returns -1), so
# the list it shows is empty by construction and nothing leaves this machine.
# A WORKING relay is required all the same: the refusal at the head of
# net_game() would otherwise turn this into a test of that refusal instead.
#
# WHY THIS GATE EXISTS. A page cannot listen for UDP -- the relay dials out
# from one ephemeral source port per handle and nothing can dial in -- so the
# browser client can never be a server. It could still SAY it was one, and that
# is the harm: sg_HostGame() calls nServerInfo::TellMasterAboutMe() whenever
# sg_TalkToMaster is set, and gServerBrowser::BrowseMaster() sets it for the
# whole of an Internet browse. So "Start your own server", an item that sits in
# EVERY browsed server list including this empty LAN one -- "Host Game" on
# screen -- was three keypresses
# from publishing a phantom entry on the community's own public master list:
# a stranger's IP advertised as a live Armagetron server that answers nothing,
# before the bridge has even been announced to the community. Master port 4533
# is inside bridge/policy.mjs's allowed range on purpose -- M-B has to READ the
# list -- so the relay is not what keeps this in. The door is.
#
# THE ROUTE. MainMenu -> Play Game -> Multiplayer -> one Down -> LAN
# Multiplayer, exactly as web/tools/bridge-gate.steps walks it and for the same
# reason (every uMenu opens on its LAST-constructed item). The server browser
# that opens constructs gServerStartMenuItem first and, with no servers found,
# constructs nothing else -- so that item, labelled "Host Game" on screen
# ($network_master_start), is the only one and the one the menu opens on. Shot
# 04 is what says whether that is still true (it also shows "Sorry, no server
# found :-(", i.e. the broadcast really did reach nobody); do not trust the key
# count if an item is ever added to gServerBrowser.
#
# TWICE, ON PURPOSE, for the reason bridge-absent-gate.steps gives: a dead
# module produces no error strings either, so "the refusal ran a second time,
# after a keypress this script sent" is the reading that separates a refusal
# from a corpse.
#
# THE VERDICT:
#   grep -c '\[console.log\].*BRIDGEGATE.*"PASS":true' /tmp/bridge-hosting/console.log
# Expected: 1. Count the [console.log] lines only -- the harness's own
# `until` echo repeats every needle it is waiting on.

until:1:90000:[PERSIST] populate ok
wait:1000
until:1:120000:[BOOT] autostart
wait:9000
shot:01-boot1-language-menu
key:Enter
wait:3000
key:Escape
until:1:30000:[PERSISTSAVE] menu-leave
wait:3000
mark:RELOAD-SO-BOOT-2-STARTS-AT-THE-REAL-MAIN-MENU
eval:location.reload()
until:2:90000:[PERSIST] populate ok
until:2:120000:[BOOT] autostart
wait:12000
shot:02-boot2-main-menu

mark:INSTRUMENT-BEFORE-TOUCHING-ANYTHING
eval:(()=>{const o=console.log;if(console.log.__aa)return 'already';window.__hostRefusals=[];const w=function(){try{if(String(arguments[0]).indexOf('hosting refused')>=0)window.__hostRefusals.push(performance.now())}catch(e){}return o.apply(console,arguments)};w.__aa=true;console.log=w;return 'hosting-refusal tap installed'})()
eval:(()=>{const o=window.setTimeout;window.__st=0;window.setTimeout=function(){window.__st++;return o.apply(this,arguments)};window.__t0=performance.now();return 'setTimeout counter installed'})()

mark:ENTER-1-PLAY-GAME-SUBMENU
key:Enter
wait:2500
mark:ENTER-2-MULTIPLAYER-SUBMENU
key:Enter
wait:2500
shot:03-network-menu-opens-on-online-multiplayer
mark:ONE-DOWN-TO-LAN-MULTIPLAYER
key:Down
wait:1500
mark:ENTER-3-LAN-BROWSE-ASKS-FOR-A-SOCKET
key:Enter
until:1:60000:[BRIDGE] open
until:1:60000:bound to udp port
wait:3000
shot:04-empty-lan-browser-with-host-game-selected

# The bridge's state BEFORE the hosting attempt. Everything about the refusal
# is "nothing happened", so the reading that carries it is a before/after pair
# on the handle table: a page that got as far as sn_SetNetState(nSERVER) would
# have asked for a listening socket, which means another BIND and another
# entry here.
eval:(()=>{const b=window.AABridge;window.__before={handles:Object.keys(b.bound).length,sent:Object.keys(b.sentSinceBind).reduce((n,h)=>n+(b.sentSinceBind[h]|0),0)};return 'before '+JSON.stringify(window.__before)})()

mark:ENTER-4-HOST-GAME-IS-REFUSED
key:Enter
until:1:30000:hosting refused
wait:2500
shot:05-hosting-refusal-message

mark:DISMISS-AND-DO-IT-AGAIN-SO-THE-MODULE-HAS-TO-BE-ALIVE
key:Enter
wait:3000
shot:06-back-in-the-network-menu
mark:ENTER-5-LAN-BROWSE-A-SECOND-TIME
key:Enter
wait:5000
shot:07-lan-browser-again
mark:ENTER-6-REFUSED-A-SECOND-TIME
key:Enter
until:2:30000:hosting refused
wait:2500
shot:08-refused-a-second-time

mark:STILL-RUNNING
key:Enter
wait:2000
eval:(()=>{window.__st=0;window.__t0=performance.now();return 'resampling'})()
wait:3000
eval:(()=>{window.__tps=+(window.__st/((performance.now()-window.__t0)/1000)).toFixed(1);return 'timeouts/sec = '+window.__tps})()
shot:09-still-alive

# ===========================================================================
# H1: HOSTING IS REFUSED, NOTHING WAS BOUND FOR IT, AND THE MODULE IS ALIVE.
#
#   refusals >= 2      the refusal ran twice, the second time after a keypress
#                      this script sent -- so C++ ran and it is repeatable.
#   no_new_handle      the handle table did not grow across either attempt. A
#                      run that reached sn_SetNetState(nSERVER) would have
#                      asked nSocket::Create for a listening socket and this
#                      count would be higher.
#   ws_readyState 1    the bridge itself is untouched by the refusal: joining
#                      still works, which is the point of refusing at this door
#                      rather than by killing the transport.
#   tps / canvas / gl  a halted module yields nothing and paints nothing.
# ===========================================================================
eval:(()=>{const b=window.AABridge;const B=window.__before||{handles:0,sent:0};const c=document.getElementById('canvas');const g=c?c.getContext('webgl'):null;const r={refusals:(window.__hostRefusals||[]).length,handles_before:B.handles,handles_after:Object.keys(b.bound).length,sent_before:B.sent,sent_after:Object.keys(b.sentSinceBind).reduce((n,h)=>n+(b.sentSinceBind[h]|0),0),ws_readyState:b.ws?b.ws.readyState:null,state:b.state,tps:window.__tps,canvas_w:c?c.width:0,canvas_h:c?c.height:0,gl_err:g?g.getError():'nogl'};r.no_new_handle=r.handles_after<=r.handles_before;r.PASS=r.refusals>=2&&r.no_new_handle&&r.ws_readyState===1&&r.tps>20&&r.canvas_w>0&&r.canvas_h>0&&r.gl_err===0;console.log('[BRIDGEGATE] H1 hosting-refused-and-nothing-was-announced '+JSON.stringify(r));return 'H1 '+r.PASS})()
