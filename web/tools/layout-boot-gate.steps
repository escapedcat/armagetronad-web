# layout-boot-gate.steps -- M9: THE LAYOUT IS DECIDED WHEN THE GAME STARTS.
#
#   python3 -m http.server 8008 --directory web/dist-m1 &
#   node web/tools/drive-browser.mjs --headed --mobile 412,915,3 \
#        --out docs/evidence/m9-layout-lock/gates/layout-boot \
#        --url 'http://localhost:8008/armagetronad.html?autostart=0' \
#        --script-file web/tools/layout-boot-gate.steps
#
# TWO CLAIMS, both about the moment main() runs:
#
#   LB3  A phone turned WHILE THE PAGE LOADS boots into the orientation it is
#        held in, not the one it was opened in. The page sizes the canvas at
#        parse time (the first paint) and once more inside startGame(), right
#        before Module.callMain (sizeCanvas's header has the argument). The
#        harness opens the page in portrait, holds main() with ?autostart=0,
#        rotates the emulated phone to landscape, releases main() with
#        AA_START() -- and the game must come up in the FULL layout with a wide
#        backing store. Before M9 it came up as a Game Boy in a landscape
#        viewport (the M7 final review's "rotated during the download").
#
#   LB4  The layout switch reloads into the OTHER layout regardless of how the
#        phone is held. Tapping "Portrait layout" in the landscape menu reloads
#        with ?layout=portrait; the phone is still landscape, and the page must
#        come up as a Game Boy with a SQUARE backing store sized as if upright
#        (sizeCanvas swaps its vw/vh for the layout asked for). ?autostart=0
#        rides along on the reload, so main() is released by hand again.
#
# The [BOOT] lines are the synchronisation points; [DISPLAY] layout= carries
# the decision and its source in words a grep can read.
until:1:90000:[BOOT] main() HELD
eval:(()=>{const c=document.getElementById('canvas');const r={layout:document.documentElement.classList.contains('aa-gameboy')?'gameboy':'full',canvas_w:c.width,canvas_h:c.height,inner:window.innerWidth+'x'+window.innerHeight};console.log('[M9GATE] LB0 parse-time '+JSON.stringify(r));return 'LB0'})()
# The loading overlay is still up while main() is held: the bar (M9) is what a
# visitor sees during the download, so it gets its one screenshot here.
shot:lb-00-loading-overlay-while-held
mark:ROTATE-WHILE-HELD
metrics:915:412:3
wait:1000
eval:AA_START()
until:1:60000:[BOOT] autostart
wait:2500
eval:(()=>{const c=document.getElementById('canvas');const b=c.getBoundingClientRect();const r={layout:document.documentElement.classList.contains('aa-gameboy')?'gameboy':'full',canvas_w:c.width,canvas_h:c.height,css_w:Math.round(b.width),css_h:Math.round(b.height),inner:window.innerWidth+'x'+window.innerHeight,square_var:getComputedStyle(document.documentElement).getPropertyValue('--aa-square').trim()};r.PASS=r.layout==='full'&&r.canvas_w>r.canvas_h&&r.canvas_w===Math.floor(window.innerWidth*window.devicePixelRatio)&&r.square_var==='0px';console.log('[M9GATE] LB3 boots-into-held-orientation '+JSON.stringify(r));return 'LB3 '+r.PASS})()
shot:lb-01-turned-while-loading-boots-landscape
# The switch, in the menu the game booted into.
wait:1500
eval:(()=>{const lb=document.getElementById('layoutbtn');const r={present:!!lb,display:lb?getComputedStyle(lb).display:null,label:lb?lb.textContent.trim():null};r.PASS=r.present&&r.display!=='none'&&r.label==='Portrait layout';console.log('[M9GATE] LB1b layout-button-in-landscape-menu '+JSON.stringify(r));return 'LB1b '+r.PASS})()
mark:TAP-THE-SWITCH
tap:#layoutbtn
until:1:60000:[TOUCH] layout switch -> ?layout=portrait
until:2:90000:[BOOT] main() HELD
wait:500
eval:AA_START()
until:2:60000:[BOOT] autostart
wait:2500
eval:(()=>{const c=document.getElementById('canvas');const b=c.getBoundingClientRect();const lb=document.getElementById('layoutbtn');const r={url_layout:new URLSearchParams(location.search).get('layout'),layout:document.documentElement.classList.contains('aa-gameboy')?'gameboy':'full',canvas_w:c.width,canvas_h:c.height,css_w:Math.round(b.width),css_h:Math.round(b.height),inner:window.innerWidth+'x'+window.innerHeight,square_var:getComputedStyle(document.documentElement).getPropertyValue('--aa-square').trim(),label:lb?lb.textContent.trim():null};r.PASS=r.url_layout==='portrait'&&r.layout==='gameboy'&&r.canvas_w===r.canvas_h&&r.canvas_w===Math.floor(Math.min(window.innerWidth,window.innerHeight)*window.devicePixelRatio)&&r.label==='Landscape layout';console.log('[M9GATE] LB4 switch-reloads-into-the-other-layout '+JSON.stringify(r));return 'LB4 '+r.PASS})()
shot:lb-02-switched-to-portrait-while-held-landscape
