# M5 task 5: the frame-rate sweep that chose MAX_CANVAS_PIXELS in web/shell.html.
#
#   python3 -m http.server 8000 --directory web/dist-m1 &
#   node docs/evidence/m5-startup/make-resolution-pages.mjs
#   node web/tools/drive-browser.mjs --headed --out /tmp/fps-1920x1080 \
#        --url http://localhost:8000/res-1920x1080.html \
#        --script-file web/tools/fps-resolution-probe.steps
#   kill %1
#
# --headed is REQUIRED for Chrome; see the header of drive-browser.mjs.
#
# WHAT IT MEASURES AND WHY IT IS NOT THE M2 GATE. This is ONE round, not a
# three-round match, and it asserts nothing: it prints the same frame-rate
# distribution the M2 gameplay gate prints, computed by the same two evals
# copied verbatim from web/tools/gameplay-gate.steps, so the numbers from a
# sweep step and the numbers from a gate run are the same quantity. The sweep
# is for CHOOSING the cap across five resolutions in a few minutes; the M2 gate,
# run at the chosen cap, is what actually certifies it against PLAN.md's >=30
# fps Demo bar. Do not quote a number from this file as a gate result.
#
# THE PAGE UNDER TEST IS A CONTROL PAGE, not armagetronad.html: each res-WxH.html
# is the shipped page plus one injected <script> setting window.AA_CANVAS_SIZE,
# so every resolution in the sweep runs the SAME .wasm, .js and .data. The only
# thing that varies between steps is the canvas backing store.
#
# The sampler counts glFlush/glFinish calls, i.e. the game's own swaps -- see
# the long comment on it in gameplay-gate.steps, including why the glGetError
# poll is every 30th frame and not every frame.
wait:1000
eval:(()=>{if(window.__fps)return 'already installed';const S={t:new Float64Array(400000),n:0,marks:[],gl:[],polls:0};window.__fps=S;const wrap=(C)=>{if(!C)return;for(const m of ['flush','finish']){const o=C.prototype[m];if(!o)continue;C.prototype[m]=function(){if(S.n<S.t.length)S.t[S.n++]=performance.now();if(S.n%30===0){S.polls++;const e=this.getError();if(e){S.gl.push([S.n,e]);if(S.gl.length<=20)console.error('[GLERR] frame '+S.n+' glGetError=0x'+e.toString(16));}}return o.apply(this,arguments);};}};wrap(window.WebGLRenderingContext);wrap(window.WebGL2RenderingContext);const cl=console.log.bind(console);console.log=function(){const s=(arguments.length&&typeof arguments[0]==='string')?arguments[0]:'';if(s.indexOf('[L] ')===0)S.marks.push([performance.now(),s]);return cl.apply(null,arguments);};return 'frame sampler armed: glFlush+glFinish counted, glGetError polled every 30th frame, [L] lines timestamped'})()

# The module needs a few seconds to fetch and instantiate; the game starts by
# itself when it is ready, so this waits for the page to say so rather than
# clicking anything.
until:1:90000:[BOOT] autostart
eval:(()=>{const c=document.getElementById('canvas');return 'canvas '+c.width+'x'+c.height+' screen '+screen.width+'x'+screen.height+' dpr '+devicePixelRatio})()
wait:6000
shot:01-language-menu
key:Enter
wait:3000
key:Escape
wait:4000
shot:02-welcome-message
key:Enter

# --------------------------------------------------------------- one round
until:1:60000:[L] NEW_ROUND
mark:ROUND-1-STARTED
wait:5500
shot:03-round1-driving
key:Left
wait:1200
key:Right
until:1:150000:[L] ROUND_WINNER
mark:ROUND-1-COMPLETE
shot:04-round1-ended

# The frame-rate dump, copied verbatim from gameplay-gate.steps. `overall` here
# spans NEW_ROUND 1 .. ROUND_WINNER 1 because there is only one round.
eval:(()=>{const S=window.__fps;if(!S)return 'no sampler';const all=Array.prototype.slice.call(S.t.subarray(0,S.n));const nr=S.marks.filter(m=>m[1].indexOf('[L] NEW_ROUND')===0).map(m=>m[0]);const rw=S.marks.filter(m=>m[1].indexOf('[L] ROUND_WINNER')===0).map(m=>m[0]);const q=(a,p)=>{if(!a.length)return null;const s=a.slice().sort((x,y)=>x-y);return s[Math.min(s.length-1,Math.max(0,Math.round(p*(s.length-1))))]};const r2=(x)=>(x===null||x===undefined)?null:Math.round(x*100)/100;const f=(v)=>(v&&v>0)?Math.round(100000/v)/100:null;const stats=(t0,t1)=>{const w=all.filter(x=>x>=t0&&x<=t1);const d=[];for(let i=1;i<w.length;i++)d.push(w[i]-w[i-1]);const sec={};for(const x of w){const k=Math.floor((x-t0)/1000);sec[k]=(sec[k]||0)+1}const span=(t1-t0)/1000;const nb=Math.floor(span);const per=[];for(let k=0;k<nb;k++)per.push(sec[k]||0);return{span_s:r2(span),frames:w.length,mean_fps:span>0?r2(w.length/span):null,frame_ms:{p50:r2(q(d,0.5)),p90:r2(q(d,0.9)),p99:r2(q(d,0.99)),max:r2(q(d,1))},inst_fps:{median:f(q(d,0.5)),p10:f(q(d,0.9)),p01:f(q(d,0.99)),min:f(q(d,1))},fps_per_second:per,fps_per_second_min:per.length?Math.min.apply(null,per):null,fps_per_second_median:q(per,0.5)}};const out={total_frames_sampled:S.n,rounds_started:nr.length,rounds_won:rw.length};const n=Math.min(nr.length,rw.length);if(n>0){out.overall=stats(nr[0],rw[n-1]);out.per_round=[];for(let i=0;i<n;i++)out.per_round.push(stats(nr[i],rw[i]))}return JSON.stringify(out)})()
