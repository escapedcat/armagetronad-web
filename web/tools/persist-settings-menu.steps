# M4 Task 2, SUPPLEMENTARY DEMONSTRATION: the same mechanism on the real
# Settings menu, not on the first-use screens.
#
#   python3 -m http.server 8000 --directory web/dist-m1 &
#   node web/tools/drive-browser.mjs --headed --out /tmp/setmenu-chrome \
#        --url http://localhost:8000/armagetronad.html?autostart=0 \
#        --script-file web/tools/persist-settings-menu.steps
#   kill %1
#
# M5 task 5: THIS GATE MUST BE DRIVEN WITH ?autostart=0 -- the URL in the recipe
# above is not optional. Removing the Play button made main() run from
# onRuntimeInitialized, which deletes the window between "the runtime is ready"
# and "main() has run" that this script's payload phases are named after
# (boot1-after-play, boot2-before-play). Measured on the first re-recording
# without it: P5, P7, P11 and P14 all fail, structurally and not because
# persistence broke. web/shell.html honours ?autostart=0 by holding main() until
# window.AA_START() is called, which is what the `eval:window.AA_START()` steps
# below do; the parameter survives the location.reload() in the middle. See the
# long comment at that hook in web/shell.html for why a query parameter rather
# than a generated control page.
#
# READ IT WITH THE TRANSCRIPT AND THE SCREENSHOTS; there is no checker, on
# purpose. web/tools/persist-settings-gate.steps is the gate, and it stays
# short and backstop-independent. This file exists because that gate changes a
# setting on the FIRST SETUP screen -- which is a real configuration menu, but
# it is not the menu a player thinks of as "settings", and a demonstration
# that only ever touched the first-use flow would leave the headline claim
# resting on an argument.
#
# WHY IT IS NOT THE GATE. Getting to the main menu at all requires FIRST_USE 0
# in user.cfg, and on this build the only thing that saves that is boot 1's
# beforeunload backstop -- gArmagetron.cpp's welcome() sets st_FirstUse=false
# after sg_StartupPlayerMenu returns and the next screen is a uMenu::Message,
# which never fires uCallbackMenuLeave. So this script only works on
# armagetronad.html and would behave differently on
# armagetronad-nobackstop.html. The gate must not have that property; this
# demonstration may.
#
# THE SETTING: "Menu Wrap", the uMenuItemToggle bound to uMenu::wrap in
# gGame.cpp's MainMenu(), which is the target of the tConfItem<bool>
# WRAP_MENU (gMenus.cpp). It defaults to 1. Chosen because toggling it has no
# side effect beyond menu cursor behaviour -- unlike its neighbours "Moviepack"
# (reloads textures) and "Text Output" (turns on console rendering).
#
# THE DISPLAY SETTINGS SUBMENU IS DELIBERATELY NOT VISITED. It leads to the
# viewport configuration screen, which is a latent abort in this port
# (rViewport.cpp), and to the resolution menu, whose changes are saved by
# lowlevel_sr_InitDisplay whether or not this task's work exists. Neither is
# something this demonstration wants to touch.
#
# MENU GEOMETRY, since the keystrokes below depend on it. uMenu renders its
# item list in REVERSE of construction order (uMenu::YPos), and uMenu's
# constructor adds the "Back" item FIRST, so Back is always at the BOTTOM and
# the last-constructed item is at the TOP and is initially selected. From
# gGame.cpp's MainMenu():
#   main menu    Play Game / Player Setup / System Setup / About / Exit Game
#   System Setup Display Settings / Sound / Misc Stuff / Back
#   Misc Stuff   Moviepack / Text Output / Menu Wrap / Global Keyboard /
#                Language / Initial Setup / Back
# Every step below is screenshotted, so a future drift in this list is visible
# rather than silently mis-navigated.

# ---------------------------------------------------------------- BOOT 1
# Walk the first-use flow just far enough to get FIRST_USE 0 persisted, then
# reload. Nothing is claimed about this boot.
until:1:90000:[PERSIST] populate ok
wait:1000
eval:window.AA_START()
wait:9000
shot:01-boot1-language-menu
key:Enter
until:1:30000:[PERSISTSAVE] menu-leave
wait:2500
shot:02-boot1-first-setup
key:Escape
until:2:30000:[PERSISTSAVE] menu-leave
wait:2500
shot:03-boot1-welcome

mark:RELOAD-REQUESTED
eval:location.reload()
until:2:90000:[PERSIST] populate ok
mark:BOOT-2-POPULATED
wait:1500

# ---------------------------------------------------------------- BOOT 2
eval:window.AA_START()
wait:9000
shot:04-boot2-main-menu

eval:(()=>{const rd=(p)=>{try{return Module.FS.readFile(p,{encoding:'utf8'})}catch(e){return null}};const c=rd('/persist/var/user.cfg');const pick=(t,k)=>{if(t===null)return null;const m=t.split('\n').find(l=>l.trim().indexOf(k+' ')===0);return m?m.trim().slice(k.length+1).trim():null};console.log('[SETMENU] '+JSON.stringify({phase:'boot2-main-menu',wrap_menu:pick(c,'WRAP_MENU'),first_use:pick(c,'FIRST_USE'),bytes:c?c.length:null}));return 'read'})()

key:Down
wait:900
key:Down
wait:900
shot:05-boot2-cursor-on-system-setup
key:Enter
wait:1800
shot:06-boot2-system-setup
key:Down
wait:900
key:Down
wait:900
shot:07-boot2-cursor-on-misc-stuff
key:Enter
wait:1800
shot:08-boot2-misc-stuff
key:Down
wait:900
key:Down
wait:900
shot:09-boot2-cursor-on-menu-wrap

# BEFORE. The value on screen is the default, and so is the value in the file.
eval:(()=>{const rd=(p)=>{try{return Module.FS.readFile(p,{encoding:'utf8'})}catch(e){return null}};const c=rd('/persist/var/user.cfg');const pick=(t,k)=>{if(t===null)return null;const m=t.split('\n').find(l=>l.trim().indexOf(k+' ')===0);return m?m.trim().slice(k.length+1).trim():null};console.log('[SETMENU] '+JSON.stringify({phase:'before-toggle',wrap_menu:pick(c,'WRAP_MENU'),bytes:c?c.length:null}));return 'read'})()

mark:THE-PLAYER-TOGGLES-MENU-WRAP
key:Enter
wait:1500
shot:10-boot2-menu-wrap-toggled

# STILL IN THE MENU. The toggle is in memory only.
eval:(()=>{const rd=(p)=>{try{return Module.FS.readFile(p,{encoding:'utf8'})}catch(e){return null}};const c=rd('/persist/var/user.cfg');const pick=(t,k)=>{if(t===null)return null;const m=t.split('\n').find(l=>l.trim().indexOf(k+' ')===0);return m?m.trim().slice(k.length+1).trim():null};console.log('[SETMENU] '+JSON.stringify({phase:'toggled-menu-still-open',wrap_menu:pick(c,'WRAP_MENU'),bytes:c?c.length:null}));return 'read'})()

mark:ESCAPE-LEAVES-MISC-STUFF
key:Escape
until:3:30000:[PERSISTSAVE] menu-leave
wait:1500
shot:11-boot2-back-in-system-setup

# AFTER. WRAP_MENU is 0 in the file, written by leaving the menu.
eval:(()=>{const rd=(p)=>{try{return Module.FS.readFile(p,{encoding:'utf8'})}catch(e){return null}};const c=rd('/persist/var/user.cfg');const pick=(t,k)=>{if(t===null)return null;const m=t.split('\n').find(l=>l.trim().indexOf(k+' ')===0);return m?m.trim().slice(k.length+1).trim():null};console.log('[SETMENU] '+JSON.stringify({phase:'after-menu-leave',wrap_menu:pick(c,'WRAP_MENU'),bytes:c?c.length:null}));return 'read'})()

# ---------------------------------------------------------------- BOOT 3
mark:SECOND-RELOAD-REQUESTED
eval:location.reload()
until:3:90000:[PERSIST] populate ok
mark:BOOT-3-POPULATED
wait:1500

eval:(()=>{const rd=(p)=>{try{return Module.FS.readFile(p,{encoding:'utf8'})}catch(e){return null}};const c=rd('/persist/var/user.cfg');const pick=(t,k)=>{if(t===null)return null;const m=t.split('\n').find(l=>l.trim().indexOf(k+' ')===0);return m?m.trim().slice(k.length+1).trim():null};console.log('[SETMENU] '+JSON.stringify({phase:'boot3-before-play',wrap_menu:pick(c,'WRAP_MENU'),bytes:c?c.length:null}));return 'read'})()

# And the game shows it: same three keystrokes, and the toggle reads the value
# the player chose two page loads ago.
eval:window.AA_START()
wait:9000
key:Down
wait:900
key:Down
wait:900
key:Enter
wait:1800
key:Down
wait:900
key:Down
wait:900
key:Enter
wait:1800
key:Down
wait:900
key:Down
wait:900
shot:12-boot3-menu-wrap-still-off

mark:positive-control-deliberate-uncaught-error-follows
eval:setTimeout(function(){null.thisIsADeliberateUncaughtError;},0)
wait:2000
shot:13-after-deliberate-uncaught-error
