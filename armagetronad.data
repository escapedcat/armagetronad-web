# artistic style configuration: just use defaults
mode=c

# humm, the defaults for those changed recently.
# better keep them around, they cause huge pointless
# changes we don't want as long as there are changes
# from 0.2.8 to merge.

# one-line=keep-blocks
# these settings are loaded JUST ONCE for every user; only if
# the file user.cfg does not exist yet. Placing anything in here
# changes the systemwide defaults, but does not affect anyone who
# has already played.

SERVER_NAME Unnamed Server
CM_LOCY -0.5

