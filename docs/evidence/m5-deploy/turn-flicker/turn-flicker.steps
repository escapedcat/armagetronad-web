# Targeted probe for a report that "every time the bike turns the screen
# flickers a bit". NOT a gate -- it answers one question and stops.
#
# It samples three things the one-shot-per-step gate cannot:
#   1. per-frame glGetError, not every 30th frame, so a GL error raised by a
#      single turn's geometry cannot fall between polls;
#   2. the frame-time series with the TURNS timestamped in the same clock, by
#      listening for keydown in the page, so "did a frame stall when the bike
#      turned" is a comparison rather than an impression;
#   3. consecutive screenshots across one turn instead of one per step.
wait:1000
eval:(()=>{const S={t:new Float64Array(200000),n:0,glerr:[],turns:[],polls:0};window.__turn=S;const wrap=(C)=>{if(!C)return;for(const m of ['flush','finish']){const o=C.prototype[m];if(!o)continue;C.prototype[m]=function(){const now=performance.now();if(S.n<S.t.length)S.t[S.n++]=now;S.polls++;const e=this.getError();if(e)S.glerr.push([S.n,now,e]);return o.apply(this,arguments);};}};wrap(window.WebGLRenderingContext);wrap(window.WebGL2RenderingContext);window.addEventListener('keydown',(ev)=>{if(ev.key==='ArrowLeft'||ev.key==='ArrowRight')S.turns.push([performance.now(),ev.key]);},true);return 'turn probe armed: per-frame glGetError, keydown-timestamped turns'})()
