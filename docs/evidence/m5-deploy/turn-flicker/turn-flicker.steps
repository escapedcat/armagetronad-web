wait:2000
eval:(()=>{const S=window.__turn;if(!S)return 'no probe';const all=Array.prototype.slice.call(S.t.subarray(0,S.n));const d=[];for(let i=1;i<all.length;i++)d.push([all[i],all[i]-all[i-1]]);const q=(a,p)=>{if(!a.length)return null;const s=a.slice().sort((x,y)=>x-y);return s[Math.min(s.length-1,Math.round(p*(s.length-1)))]};const r2=(x)=>x==null?null:Math.round(x*100)/100;const deltas=d.map(x=>x[1]);const base={frames:all.length,p50:r2(q(deltas,0.5)),p99:r2(q(deltas,0.99)),max:r2(q(deltas,1))};const perTurn=S.turns.map(([t,k])=>{const w=d.filter(x=>x[0]>=t-200&&x[0]<=t+700);const wd=w.map(x=>x[1]);return{key:k,at:r2(t),frames:w.length,max_ms:r2(q(wd,1)),over25ms:wd.filter(x=>x>25).length,over40ms:wd.filter(x=>x>40).length}});const away=d.filter(x=>!S.turns.some(([t])=>x[0]>=t-200&&x[0]<=t+700)).map(x=>x[1]);const off={frames:away.length,p99:r2(q(away,0.99)),max:r2(q(away,1)),over25ms:away.filter(x=>x>25).length,over40ms:away.filter(x=>x>40).length};return JSON.stringify({overall:base,glGetError_polls:S.polls,glGetError_nonzero:S.glerr.length,glGetError_first:S.glerr.slice(0,5),turns:perTurn,away_from_turns:off})})()
