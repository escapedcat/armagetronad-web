eval:(()=>{const cv=document.getElementById('canvas');const S={last:cv.width+'x'+cv.height,changes:[],glerr:0,polls:0};window.__A=S;const wrap=(C)=>{if(!C)return;for(const m of ['flush','finish']){const o=C.prototype[m];if(!o)continue;C.prototype[m]=function(){S.polls++;const e=this.getError();if(e){S.glerr++;if(S.glerr<6)console.log('[RES] GLERR '+e);}return o.apply(this,arguments);};}};wrap(window.WebGLRenderingContext);wrap(window.WebGL2RenderingContext);setInterval(()=>{const s=cv.width+'x'+cv.height;if(s!==S.last){console.log('[RES] canvas-changed '+S.last+' -> '+s);S.changes.push([S.last,s]);S.last=s;}},40);S.dump=(p)=>{const g=cv.getContext('webgl')||cv.getContext('webgl2');console.log('[RES] '+JSON.stringify({phase:p,w:cv.width,h:cv.height,changes:S.changes.length,lost:g?g.isContextLost():'nogl',polls:S.polls,glerr:S.glerr}));return p};return 'probe armed'})()
