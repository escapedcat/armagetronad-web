# DEFECT A probe: does "Apply Changes" (sr_ReinitDisplay) do anything live?
until:1:90000:[PERSIST] populate ok
wait:1000
eval:(()=>{const cv=document.getElementById('canvas');const S={last:cv.width+'x'+cv.height,events:[],changes:[]};window.__A=S;for(const e of ['webglcontextlost','webglcontextrestored','webglcontextcreationerror']){cv.addEventListener(e,(ev)=>{S.events.push([e,performance.now()]);console.log('[RES] EVENT '+e);},false);}setInterval(()=>{const s=cv.width+'x'+cv.height;if(s!==S.last){console.log('[RES] canvas-changed '+S.last+' -> '+s);S.changes.push([S.last,s,performance.now()]);S.last=s;}},40);S.dump=(p)=>{const g=cv.getContext('webgl')||cv.getContext('webgl2')||cv.getContext('experimental-webgl');let info={};try{info={lost:g?g.isContextLost():'nogl',vp:g?Array.from(g.getParameter(g.VIEWPORT)):null,dbw:g?g.drawingBufferWidth:null,dbh:g?g.drawingBufferHeight:null};}catch(e){info={err:String(e)};}console.log('[RES] '+JSON.stringify(Object.assign({phase:p,w:cv.width,h:cv.height,cw:cv.clientWidth,ch:cv.clientHeight,styleW:cv.style.width,styleH:cv.style.height,changes:S.changes.length,events:S.events.length},info)));return p};return 'probe armed'})()
eval:window.__A.dump('boot1-before-play')
click:#start
wait:9000
shot:00-boot1-language-menu
key:Enter
until:1:30000:[PERSISTSAVE] menu-leave
wait:2500
shot:01-boot1-first-setup
key:Escape
until:2:30000:[PERSISTSAVE] menu-leave
wait:3000
shot:02-boot1-after-first-setup
mark:RELOAD-1
eval:location.reload()
until:2:90000:[PERSIST] populate ok
wait:1500
eval:(()=>{const cv=document.getElementById('canvas');const S={last:cv.width+'x'+cv.height,events:[],changes:[]};window.__A=S;for(const e of ['webglcontextlost','webglcontextrestored','webglcontextcreationerror']){cv.addEventListener(e,(ev)=>{S.events.push([e,performance.now()]);console.log('[RES] EVENT '+e);},false);}setInterval(()=>{const s=cv.width+'x'+cv.height;if(s!==S.last){console.log('[RES] canvas-changed '+S.last+' -> '+s);S.changes.push([S.last,s,performance.now()]);S.last=s;}},40);S.dump=(p)=>{const g=cv.getContext('webgl')||cv.getContext('webgl2')||cv.getContext('experimental-webgl');let info={};try{info={lost:g?g.isContextLost():'nogl',vp:g?Array.from(g.getParameter(g.VIEWPORT)):null,dbw:g?g.drawingBufferWidth:null,dbh:g?g.drawingBufferHeight:null};}catch(e){info={err:String(e)};}console.log('[RES] '+JSON.stringify(Object.assign({phase:p,w:cv.width,h:cv.height,cw:cv.clientWidth,ch:cv.clientHeight,styleW:cv.style.width,styleH:cv.style.height,changes:S.changes.length,events:S.events.length},info)));return p};return 'probe armed'})()
