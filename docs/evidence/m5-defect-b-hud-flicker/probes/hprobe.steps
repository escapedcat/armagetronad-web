eval:(()=>{const cv=document.getElementById('canvas');const R=[{n:'hudbar',x:0,y:660,w:1024,h:108},{n:'fps',x:840,y:44,w:140,h:40}];const off=document.createElement('canvas');const c2=off.getContext('2d',{willReadFrequently:true});const S={n:0,glerr:0,regions:R.map(r=>({name:r.n,rect:r,N:r.w*r.h,ring:[new Uint8Array(r.w*r.h),new Uint8Array(r.w*r.h),new Uint8Array(r.w*r.h)],tot:[],blip:[],d1:[],top:[]})),t:[],mark:0};window.__H=S;off.width=1024;off.height=768;const grab=(R0,buf)=>{const r=R0.rect;c2.clearRect(0,0,r.w,r.h);c2.drawImage(cv,r.x,r.y,r.w,r.h,0,0,r.w,r.h);const d=c2.getImageData(0,0,r.w,r.h).data;let tot=0;for(let i=0,o=0;i<R0.N;i++,o+=4){const l=(d[o]*77+d[o+1]*151+d[o+2]*28)>>8;buf[i]=l;if(l>170)tot++;}return tot;};const mad=(a,b,N)=>{let s=0;for(let i=0;i<N;i++)s+=Math.abs(a[i]-b[i]);return s/N;};const sample=()=>{S.t.push(performance.now());for(const R0 of S.regions){R0.tot.push(grab(R0,R0.ring[S.n%3]));}S.n++;if(S.n>=3){for(const R0 of S.regions){const a=R0.ring[(S.n-3)%3],b=R0.ring[(S.n-2)%3],c=R0.ring[(S.n-1)%3];const d1=mad(a,b,R0.N),d2=mad(b,c,R0.N),d0=mad(a,c,R0.N);const bl=(d1+d2)/2-d0;R0.d1.push(d1);R0.blip.push(bl);const worst=R0.top.length>=4?R0.top[3].blip:-1e9;if(bl>worst){R0.top.push({i:S.n-2,t:Math.round(S.t[S.n-2]),blip:Math.round(bl*1000)/1000,d1:Math.round(d1*1000)/1000,d0:Math.round(d0*1000)/1000,ta:R0.tot[S.n-3],tb:R0.tot[S.n-2],tc:R0.tot[S.n-1],a:a.slice(),b:b.slice(),c:c.slice()});R0.top.sort((x,y)=>y.blip-x.blip);if(R0.top.length>4)R0.top.length=4;}}}};const patch=(C)=>{if(!C||!C.prototype||!C.prototype.finish)return;const o=C.prototype.finish;C.prototype.finish=function(){const e=this.getError();if(e)S.glerr++;sample();return o.apply(this,arguments);};};patch(window.WebGLRenderingContext);patch(window.WebGL2RenderingContext);return 'H probe armed regions='+R.map(r=>r.n).join(',')})()
