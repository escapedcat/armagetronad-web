eval:(()=>{const S=window.__H;const q=(a,p)=>{const s=a.slice().sort((x,y)=>x-y);return s[Math.min(s.length-1,Math.round(p*(s.length-1)))]};const r3=(x)=>Math.round(x*1000)/1000;const out={frames:S.n-S.mark,glerr:S.glerr,regions:[]};for(const R of S.regions){const b=R.blip.slice(S.mark),d=R.d1.slice(S.mark),t=R.tot.slice(S.mark);const n=b.length;if(n<20)continue;let drop=0;const dex=[];for(let i=1;i<n-1;i++){const nb=Math.min(t[i-1],t[i+1]);if(nb>=40&&t[i]<=0.75*nb){drop++;if(dex.length<6)dex.push([i,t[i-1],t[i],t[i+1]]);}}out.regions.push({name:R.name,rect:R.rect,frames:n,bright_med:q(t,0.5),bright_min:q(t,0),bright_p05:q(t,0.05),bright_p95:q(t,0.95),oneframe_bright_dropouts:drop,dropout_ex:dex,framediff_p50:r3(q(d,0.5)),framediff_p95:r3(q(d,0.95)),framediff_max:r3(q(d,1)),blip_p50:r3(q(b,0.5)),blip_p95:r3(q(b,0.95)),blip_p99:r3(q(b,0.99)),blip_max:r3(q(b,1)),blip_over_1:b.filter(x=>x>1).length,blip_over_3:b.filter(x=>x>3).length,blip_over_10:b.filter(x=>x>10).length,worst:R.top.map(e=>({i:e.i,t:e.t,blip:e.blip,d1:e.d1,d0:e.d0,bright:[e.ta,e.tb,e.tc]}))});}return JSON.stringify(out)})()
eval:(()=>{const S=window.__H;const old=document.getElementById('__ov');if(old)old.remove();const div=document.createElement('div');div.id='__ov';div.style.cssText='position:fixed;left:0;top:0;width:100%;height:100%;background:#101010;z-index:999999;color:#eee;font:11px monospace;padding:2px;overflow:hidden';const R=S.regions[0];const strip=(buf,label,bd,amp)=>{const c=document.createElement('canvas');c.width=R.rect.w;c.height=R.rect.h;c.style.cssText='display:block;width:1008px;height:53px;image-rendering:pixelated;border:1px solid '+bd;const x=c.getContext('2d');const im=x.createImageData(R.rect.w,R.rect.h);for(let i=0,o=0;i<R.N;i++,o+=4){const v=amp?Math.min(255,buf[i]*4):buf[i];im.data[o]=v;im.data[o+1]=amp?v>>2:v;im.data[o+2]=amp?v>>2:v;im.data[o+3]=255;}x.putImageData(im,0,0);const t=document.createElement('div');t.textContent=label;div.appendChild(t);div.appendChild(c);};const k=Math.min(2,R.top.length);for(let j=0;j<k;j++){const e=R.top[j];const d=new Uint8Array(R.N);for(let i=0;i<R.N;i++)d[i]=Math.abs(e.b[i]-e.a[i]);strip(e.a,'WORST BLIP #'+j+' (blip='+e.blip+', d1='+e.d1+', d0='+e.d0+', t='+e.t+'ms) -- frame '+(e.i-1)+' BEFORE, bright='+e.ta,'#444',false);strip(e.b,'frame '+e.i+' THE CANDIDATE, bright='+e.tb,'#4a4',false);strip(e.c,'frame '+(e.i+1)+' AFTER, bright='+e.tc,'#444',false);strip(d,'|before - candidate| x4','#a44',true);}document.body.appendChild(div);return 'overlay rows='+k})()
