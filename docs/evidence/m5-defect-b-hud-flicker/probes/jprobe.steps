mark:ARM-PAIRED-SAMPLER
eval:(()=>{const cv=document.getElementById('canvas');const R={x:0,y:684,w:1024,h:84},N=R.w*R.h;const off=document.createElement('canvas');off.width=R.w;off.height=R.h;const c2=off.getContext('2d',{willReadFrequently:true});const S={ev:[],glerr:0,run:true,fin:0,mark:0,R:R,N:N,pairs:[],worst:[]};window.__J=S;const buf=new Uint8Array(N);const meas=()=>{c2.drawImage(cv,R.x,R.y,R.w,R.h,0,0,R.w,R.h);const d=c2.getImageData(0,0,R.w,R.h).data;let b=0;for(let i=0,o=0;i<N;i++,o+=4){const l=(d[o]*77+d[o+1]*151+d[o+2]*28)>>8;buf[i]=l;if(l>170)b++;}return b;};const patch=(C)=>{if(!C||!C.prototype||!C.prototype.finish)return;const o=C.prototype.finish;C.prototype.finish=function(){const e=this.getError();if(e)S.glerr++;S.fin++;S.ev.push([performance.now(),meas(),0]);return o.apply(this,arguments);};};patch(window.WebGLRenderingContext);patch(window.WebGL2RenderingContext);const loop=(ts)=>{if(!S.run)return;const f=S.fin;S.fin=0;const b=meas();S.ev.push([performance.now(),b,1,f]);const L=S.ev.length;let prev=-1;for(let i=L-2;i>=0&&i>L-12;i--){if(S.ev[i][2]===0){prev=S.ev[i][1];break;}}if(prev>=0){S.pairs.push([Math.round(ts),prev,b,f]);if(prev>=150&&b<=0.5*prev&&S.worst.length<4)S.worst.push({t:Math.round(ts),swap:prev,composite:b,fin:f,img:buf.slice()});}requestAnimationFrame(loop);};requestAnimationFrame(loop);return 'J probe armed: swap-time AND composite-time sampling of the same strip'})()
