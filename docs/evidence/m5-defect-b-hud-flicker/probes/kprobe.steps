# DEFECT B probe v10: light rAF-only sampler -- what the COMPOSITOR sees.
#
# M5 task 5 updated the two `click:#start` steps to `until:...[BOOT] autostart`
# when the Play button was removed; nothing else changed, so the numbers this
# prints are directly comparable with task 4c's. The HUD strip and world
# reference rectangles below are in canvas pixels and assume a 1024x768 canvas,
# which is what the driver's default 1024x768 window now produces (the canvas is
# sized from the viewport) -- run it at that window size or move the rects.
#
#   python3 -m http.server 8000 --directory web/dist-m1 &
#   node web/tools/drive-browser.mjs --headed --out /tmp/k-shipped \
#        --script-file docs/evidence/m5-defect-b-hud-flicker/probes/kprobe.steps
#   node web/tools/drive-browser.mjs --headed --out /tmp/k-oldyield \
#        --url http://localhost:8000/armagetronad-oldyield.html \
#        --script-file docs/evidence/m5-defect-b-hud-flicker/probes/kprobe.steps
#   node web/tools/drive-firefox.mjs --out /tmp/k-shipped-ff \
#        --script-file docs/evidence/m5-defect-b-hud-flicker/probes/kprobe.steps
