mark:ARM-LIGHT-RAF-SAMPLER
# M5 task 5 addition, purely additive: timestamp the game's ladder-log lines in
# the SAME clock the sampler uses, so a HUD-gone run can be attributed to what
# the game was doing rather than called "legitimate" because it is long. Module
# print routes stdout through console.log and resolves `console` at call time,
# so replacing it here catches everything the game prints; the original is kept
# bound, so CDP/BiDi still see every line.
eval:(()=>{const M=[];window.__KM=M;const cl=console.log.bind(console);console.log=function(){const s=(arguments.length&&typeof arguments[0]==='string')?arguments[0]:'';if(s.indexOf('[L] ')===0)M.push([Math.round(performance.now()),s.trim()]);return cl.apply(null,arguments)};return 'ladder-log timestamper armed'})()
eval:(()=>{const cv=document.getElementById('canvas');const HR={x:0,y:700,w:1024,h:68},WR={x:380,y:130,w:300,h:60};const oh=document.createElement('canvas');oh.width=HR.w;oh.height=HR.h;const ch=oh.getContext('2d',{willReadFrequently:true});const ow=document.createElement('canvas');ow.width=WR.w;ow.height=WR.h;const cw=ow.getContext('2d',{willReadFrequently:true});const S={ticks:[],fin:0,finTotal:0,glerr:0,run:true,t0:performance.now(),HR:HR,shots:[]};window.__K=S;const buf=new Uint8Array(HR.w*HR.h);const patch=(C)=>{if(!C||!C.prototype||!C.prototype.finish)return;const o=C.prototype.finish;C.prototype.finish=function(){S.fin++;S.finTotal++;return o.apply(this,arguments);};};patch(window.WebGLRenderingContext);patch(window.WebGL2RenderingContext);const loop=(ts)=>{if(!S.run)return;const f=S.fin;S.fin=0;ch.drawImage(cv,HR.x,HR.y,HR.w,HR.h,0,0,HR.w,HR.h);const d=ch.getImageData(0,0,HR.w,HR.h).data;let h=0;for(let i=0,o=0;i<HR.w*HR.h;i++,o+=4){const l=(d[o]*77+d[o+1]*151+d[o+2]*28)>>8;buf[i]=l;if(l>170)h++;}cw.drawImage(cv,WR.x,WR.y,WR.w,WR.h,0,0,WR.w,WR.h);const e=cw.getImageData(0,0,WR.w,WR.h).data;let w=0;for(let o=0;o<WR.w*WR.h*4;o+=4){if(((e[o]*77+e[o+1]*151+e[o+2]*28)>>8)>60)w++;}S.ticks.push([Math.round(ts),h,w,f]);if(S.ticks.length>200){const r=S.ticks.slice(-400).map(x=>x[1]).sort((a,b)=>a-b);const med=r[r.length>>1];if(med>=120&&h<=0.15*med&&w>=1500&&S.shots.length<3)S.shots.push({t:Math.round(ts),hud:h,world:w,fin:f,med:med,img:buf.slice()});}requestAnimationFrame(loop);};requestAnimationFrame(loop);return 'K probe armed (rAF only, light)'})()
