shot:02-late
eval:(()=>{const S=window.__K;const T=S.ticks;const n=T.length;if(n<50)return 'few '+n;const q=(a,p)=>{const s=a.slice().sort((x,y)=>x-y);return s[Math.min(s.length-1,Math.round(p*(s.length-1)))]};const dur=(T[n-1][0]-T[0][0])/1000;const hud=T.map(x=>x[1]),wo=T.map(x=>x[2]),fin=T.map(x=>x[3]);const wmed=q(wo,0.5);const live=T.filter(x=>x[2]>=0.7*wmed);const lh=live.map(x=>x[1]);const lmed=q(lh,0.5);const gone=live.filter(x=>x[1]<=0.15*lmed);const part=live.filter(x=>x[1]<=0.5*lmed);let runs=0,inrun=false;const runlens=[];let cur=0;for(const t of live){const g=t[1]<=0.15*lmed;if(g){cur++;inrun=true;}else{if(inrun){runs++;runlens.push(cur);cur=0;inrun=false;}}}if(inrun){runs++;runlens.push(cur);}return JSON.stringify({seconds:Math.round(dur*10)/10,raf_ticks:n,raf_hz:Math.round(n/dur*10)/10,game_swaps:S.finTotal,game_fps:Math.round(S.finTotal/dur*10)/10,swaps_per_tick_p50:q(fin,0.5),swaps_per_tick_zero:fin.filter(x=>x===0).length,world_med:wmed,ticks_world_up:live.length,hud_med:lmed,hud_p01:q(lh,0.01),hud_p05:q(lh,0.05),hud_p10:q(lh,0.1),hud_p25:q(lh,0.25),HUD_GONE_ticks:gone.length,HUD_GONE_pct:Math.round(gone.length/live.length*1000)/10,HUD_HALF_OR_LESS_ticks:part.length,HUD_HALF_pct:Math.round(part.length/live.length*1000)/10,gone_runs:runs,gone_run_len_max:runlens.length?Math.max.apply(null,runlens):0,gone_run_len_p50:runlens.length?q(runlens,0.5):0,saved:S.shots.length})})()
eval:(()=>{const S=window.__K;const R=S.HR;const old=document.getElementById('__ov');if(old)old.remove();const div=document.createElement('div');div.id='__ov';div.style.cssText='position:fixed;left:0;top:0;width:100%;height:100%;background:#101010;z-index:999999;color:#eee;font:12px monospace;padding:4px;overflow:hidden';if(!S.shots.length){div.textContent='rAF SAMPLER: no compositor tick showed the world drawn with the HUD gone.';document.body.appendChild(div);return 'overlay empty';}for(const e of S.shots){const t=document.createElement('div');t.textContent='COMPOSITE t='+e.t+'ms  hud_bright='+e.hud+' (running median '+e.med+')  world_bright='+e.world+'  game_swaps_since_previous_tick='+e.fin;div.appendChild(t);const c=document.createElement('canvas');c.width=R.w;c.height=R.h;c.style.cssText='display:block;width:1008px;height:67px;image-rendering:pixelated;border:1px solid #4a4;margin-bottom:6px';const x=c.getContext('2d');const im=x.createImageData(R.w,R.h);for(let i=0,o=0;i<R.w*R.h;i++,o+=4){const v=e.img[i];im.data[o]=v;im.data[o+1]=v;im.data[o+2]=v;im.data[o+3]=255;}x.putImageData(im,0,0);div.appendChild(c);}document.body.appendChild(div);return 'overlay rows='+S.shots.length})()
# M5 task 5 addition, purely additive: WHAT each HUD-gone run WAS. Prints every
# run of consecutive world-up ticks with the HUD at or below 15% of its running
# median, with its wall-clock span and the ladder-log lines that fall inside it
# or in the 4 s before it. A run that brackets a ROUND_WINNER / NEW_ROUND pair
# is the game legitimately not drawing the HUD between rounds; a run with
# nothing near it is a defect. This is what turns "three long stretches, both
# builds, presumed legitimate" into a statement with evidence under it.
eval:(()=>{const S=window.__K;const M=window.__KM||[];const T=S.ticks;const q=(a,p)=>{const s=a.slice().sort((x,y)=>x-y);return s[Math.min(s.length-1,Math.round(p*(s.length-1)))]};const wmed=q(T.map(x=>x[2]),0.5);const live=T.filter(x=>x[2]>=0.7*wmed);const lmed=q(live.map(x=>x[1]),0.5);const runs=[];let cur=null;for(const t of live){const gone=t[1]<=0.15*lmed;if(gone){if(!cur)cur={t0:t[0],t1:t[0],n:0};cur.t1=t[0];cur.n++;}else if(cur){runs.push(cur);cur=null;}}if(cur)runs.push(cur);const out=runs.map(r=>({ticks:r.n,ms:r.t1-r.t0,from_ms:r.t0,to_ms:r.t1,ladder:M.filter(m=>m[0]>=r.t0-4000&&m[0]<=r.t1+500).map(m=>(m[0]-r.t0)+'ms '+m[1])}));console.log('[HUDRUNS] '+JSON.stringify({hud_median:lmed,world_median:wmed,live_ticks:live.length,runs:out.length,long_runs:out.filter(r=>r.ms>=300).length,short_runs:out.filter(r=>r.ms<300).length,detail:out.filter(r=>r.ms>=300).slice(0,8),shortest_examples:out.filter(r=>r.ms<300).slice(0,6)}));return 'hud runs printed'})()
